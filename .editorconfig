root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{xaml,csproj,props,json,yml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.CA1848.severity = none   # LoggerMessage delegates: not worth it in a desktop app
dotnet_diagnostic.CA1873.severity = none   # same: log levels are fixed in this app
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1002.severity = none
dotnet_diagnostic.CA2227.severity = none   # EF navigation collections need setters
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA1303.severity = none
dotnet_diagnostic.CA1861.severity = none   # small literal arrays in report code are fine
dotnet_diagnostic.CA1859.severity = none   # Task vs Task<bool> on commands: readability first

[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none   # Test_names_with_underscores
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1849.severity = none
dotnet_diagnostic.xUnit1051.severity = none
