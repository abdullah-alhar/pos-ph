<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>VetPos.App</RootNamespace>
    <AssemblyName>VetPOS</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF's Fluent ThemeMode is still marked experimental in .NET 10. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <StartupObject>VetPos.App.Program</StartupObject>
    <ApplicationIcon>Assets\vetpos.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <!-- Program.Main starts Velopack (install / update hooks) before WPF. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\vetpos-256.png" />
    <Resource Include="Assets\vetpos.ico" />
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\Fonts\*LICENSE*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VetPos.Core\VetPos.Core.csproj" />
    <ProjectReference Include="..\VetPos.Data\VetPos.Data.csproj" />
    <ProjectReference Include="..\VetPos.Printing\VetPos.Printing.csproj" />
    <ProjectReference Include="..\VetPos.AI\VetPos.AI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="System.Speech" />
  </ItemGroup>
</Project>
