<UserControl x:Class="VetPos.App.Shell.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ds="clr-namespace:VetPos.App.DesignSystem"
             xmlns:shell="clr-namespace:VetPos.App.Shell"
             xmlns:billing="clr-namespace:VetPos.App.Features.Billing"
             xmlns:stock="clr-namespace:VetPos.App.Features.StockEntry"
             xmlns:products="clr-namespace:VetPos.App.Features.Products"
             xmlns:reports="clr-namespace:VetPos.App.Features.Reports"
             xmlns:editor="clr-namespace:VetPos.App.Features.BillEditor"
             xmlns:settings="clr-namespace:VetPos.App.Features.Settings"
             xmlns:assistant="clr-namespace:VetPos.App.Features.Assistant"
             xmlns:labels="clr-namespace:VetPos.App.Features.Labels"
             xmlns:home="clr-namespace:VetPos.App.Features.Home"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance shell:ShellViewModel}">
  <UserControl.Resources>
    <DataTemplate DataType="{x:Type billing:BillingViewModel}"><billing:BillingView /></DataTemplate>
    <DataTemplate DataType="{x:Type stock:StockEntryViewModel}"><stock:StockEntryView /></DataTemplate>
    <DataTemplate DataType="{x:Type products:ProductsViewModel}"><products:ProductsView /></DataTemplate>
    <DataTemplate DataType="{x:Type reports:ReportsViewModel}"><reports:ReportsView /></DataTemplate>
    <DataTemplate DataType="{x:Type editor:BillEditorViewModel}"><editor:BillEditorView /></DataTemplate>
    <DataTemplate DataType="{x:Type settings:SettingsViewModel}"><settings:SettingsView /></DataTemplate>
    <DataTemplate DataType="{x:Type assistant:AssistantViewModel}"><assistant:AssistantView /></DataTemplate>
    <DataTemplate DataType="{x:Type labels:LabelsViewModel}"><labels:LabelsView /></DataTemplate>
    <DataTemplate DataType="{x:Type home:HomeViewModel}">
      <home:HomeView Items="{Binding DataContext.Items, RelativeSource={RelativeSource AncestorType=UserControl}}" />
    </DataTemplate>

    <Style x:Key="MenuItemButton" TargetType="Button" BasedOn="{StaticResource Button.Subtle}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10,0,10,0" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
      <Setter Property="MinHeight" Value="36" />
    </Style>
  </UserControl.Resources>

  <UserControl.InputBindings>
    <KeyBinding Gesture="Ctrl+1" Command="{Binding NavigateCommand}" CommandParameter="Ctrl+1" />
    <KeyBinding Gesture="Ctrl+2" Command="{Binding NavigateCommand}" CommandParameter="Ctrl+2" />
    <KeyBinding Gesture="Ctrl+3" Command="{Binding NavigateCommand}" CommandParameter="Ctrl+3" />
    <KeyBinding Gesture="Ctrl+4" Command="{Binding NavigateCommand}" CommandParameter="Ctrl+4" />
    <KeyBinding Gesture="Ctrl+5" Command="{Binding NavigateCommand}" CommandParameter="Ctrl+5" />
    <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleSidebarCommand}" />
    <KeyBinding Gesture="Ctrl+6" Command="{Binding NavigateCommand}" CommandParameter="Ctrl+6" />
    <KeyBinding Gesture="Ctrl+7" Command="{Binding NavigateCommand}" CommandParameter="Ctrl+7" />
    <KeyBinding Gesture="Ctrl+8" Command="{Binding NavigateCommand}" CommandParameter="Ctrl+8" />
    <KeyBinding Gesture="Ctrl+0" Command="{Binding GoHomeCommand}" />
    <KeyBinding Gesture="Ctrl+J" Command="{Binding ToggleAssistantCommand}" />
    <KeyBinding Gesture="Ctrl+K" Command="{Binding OpenPaletteCommand}" />
    <KeyBinding Key="F1" Command="{Binding ShowHelpCommand}" />
    <KeyBinding Gesture="Ctrl+L" Command="{Binding LockCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+L" Command="{Binding LogoutCommand}" />
  </UserControl.InputBindings>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <!-- ───────── Sidebar: slim icon bar, or full names (button at the bottom, or Ctrl+B) ───────── -->
    <Border Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,1,0">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Width" Value="{StaticResource Width.Sidebar}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Collapsed}" Value="True">
              <Setter Property="Width" Value="{StaticResource Width.SidebarCollapsed}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Border.Resources>
        <Style x:Key="RailButton" TargetType="Button">
          <Setter Property="Focusable" Value="False" />
          <Setter Property="Cursor" Value="Hand" />
          <Setter Property="Foreground" Value="{DynamicResource Brush.SidebarMuted}" />
          <Setter Property="HorizontalContentAlignment" Value="Center" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Root" MinHeight="38" Margin="8,2" Padding="10,0" CornerRadius="7" Background="Transparent">
                  <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SidebarAccent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.SidebarText}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
          <Style.Triggers>
            <DataTrigger Binding="{Binding Collapsed}" Value="False">
              <Setter Property="HorizontalContentAlignment" Value="Left" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
        <Style x:Key="RailLabel" TargetType="TextBlock">
          <Setter Property="Margin" Value="14,0,0,0" />
          <Setter Property="FontSize" Value="{StaticResource FontSize.Nav}" />
          <Setter Property="VerticalAlignment" Value="Center" />
          <Setter Property="Visibility" Value="{Binding DataContext.Collapsed, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVisibility}}" />
        </Style>
      </Border.Resources>
      <DockPanel>
        <!-- Shop logo + name -->
        <Button DockPanel.Dock="Top" Style="{StaticResource RailButton}" Command="{Binding GoHomeCommand}"
                ToolTip="Home (Ctrl+0)" AutomationProperties.Name="Home" Margin="0,10,0,6">
          <StackPanel Orientation="Horizontal">
            <Border Width="42" Height="42" CornerRadius="8" Background="White" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" Padding="5">
              <Grid>
                <Image Source="/VetPOS;component/Assets/vetpos-256.png" Visibility="{Binding ShopLogo, Converter={StaticResource NullToVisible}}" />
                <Image Source="{Binding ShopLogo}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
              </Grid>
            </Border>
            <TextBlock Text="VetPOS" Style="{StaticResource RailLabel}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.SidebarText}" />
          </StackPanel>
        </Button>
        <Button DockPanel.Dock="Top" Style="{StaticResource RailButton}" Command="{Binding OpenPaletteCommand}" ToolTip="Find products, bills and screens (Ctrl+K)" AutomationProperties.Name="Search" Margin="0,0,0,6">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Font.Icons}" FontSize="17" Width="24" TextAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Text="Search" Style="{StaticResource RailLabel}" />
          </StackPanel>
        </Button>

        <!-- Bottom: notifications, AI, me, expand -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12">
          <Border Height="1" Background="{DynamicResource Brush.SidebarLine}" Margin="16,0,16,8" />
          <Button Style="{StaticResource RailButton}" Command="{Binding Updates.ShowUpdateProgressCommand}"
                  ToolTip="{Binding Updates.Status}" AutomationProperties.Name="{Binding Updates.Status}"
                  Visibility="{Binding Updates.ShowBackgroundProgress, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE896;" FontFamily="{StaticResource Font.Icons}" FontSize="17" Width="24" TextAlignment="Center"
                         Foreground="{DynamicResource Brush.AccentText}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Updates.BackgroundProgressLabel}" Style="{StaticResource RailLabel}" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource RailButton}" Command="{Binding ToggleNoticesCommand}" ToolTip="Notifications">
            <Grid>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource Font.Icons}" FontSize="17" Width="24" TextAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Text="Notifications" Style="{StaticResource RailLabel}" />
              </StackPanel>
              <Border CornerRadius="8" MinWidth="16" Height="16" Padding="4,0" Background="{DynamicResource Brush.Danger}" HorizontalAlignment="Left" VerticalAlignment="Top"
                      Margin="11,-8,0,0" Visibility="{Binding NoticeCount, Converter={StaticResource PositiveToVisible}}">
                <TextBlock Text="{Binding NoticeCount}" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Button>
          <Button Style="{StaticResource RailButton}" Command="{Binding ToggleAssistantCommand}" ToolTip="Ask AI (Ctrl+J)">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource AiSpark}" Width="24" Height="24" Fill="{DynamicResource Brush.SidebarPrimary}" />
              <TextBlock Text="Ask AI" Style="{StaticResource RailLabel}" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource RailButton}" Command="{Binding ToggleUserMenuCommand}" ToolTip="{Binding Session.User.FullName}" Margin="0,2,0,0">
            <StackPanel Orientation="Horizontal">
              <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Brush.SidebarPrimary}" Margin="-6,0,0,0">
                <TextBlock Text="{Binding Session.Initials}" FontWeight="SemiBold" FontSize="13" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{Binding Session.User.FullName}" Style="{StaticResource RailLabel}" Margin="10,0,0,0" Foreground="{DynamicResource Brush.SidebarText}"
                         TextTrimming="CharacterEllipsis" MaxWidth="130" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource RailButton}" Command="{Binding ToggleSidebarCommand}" Margin="0,2,0,0">
            <Button.ToolTip>
              <TextBlock>
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="Make the menu narrow (Ctrl+B)" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Collapsed}" Value="True"><Setter Property="Text" Value="Show the menu with names (Ctrl+B)" /></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Button.ToolTip>
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource Font.Icons}" FontSize="18" Width="26" TextAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="&#xE76B;" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Collapsed}" Value="True"><Setter Property="Text" Value="&#xE76C;" /></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Text="Narrow menu" Style="{StaticResource RailLabel}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Pages -->
        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0" Padding="0" Focusable="False"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.SidebarMuted}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Grid Margin="0,3">
                      <Border x:Name="Mark" Width="4" Height="30" CornerRadius="0,2,2,0" HorizontalAlignment="Left" Background="{DynamicResource Brush.Accent}" Visibility="Hidden" />
                      <Border x:Name="Root" Margin="8,0" CornerRadius="7" Background="Transparent">
                        <ContentPresenter />
                      </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SurfaceSubtle}" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.SidebarText}" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SidebarAccent}" />
                        <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.SidebarText}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type shell:NavItem}">
              <Grid ToolTip="{Binding Shortcut}">
                <StackPanel x:Name="Narrow" Margin="2,5" HorizontalAlignment="Center">
                  <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Font.Icons}" FontSize="18"
                             HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                  <TextBlock Text="{Binding ShortTitle}" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                </StackPanel>
                <DockPanel x:Name="Wide" Margin="12,9" Visibility="Collapsed">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Shortcut}" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Center"
                             Foreground="{DynamicResource Brush.SidebarMuted}" />
                  <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" FontFamily="{StaticResource Font.Icons}" FontSize="17" Width="26" VerticalAlignment="Center"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                  <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                </DockPanel>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding DataContext.Collapsed, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False">
                  <Setter TargetName="Narrow" Property="Visibility" Value="Collapsed" />
                  <Setter TargetName="Wide" Property="Visibility" Value="Visible" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ───────── Page ───────── -->
    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Top" Padding="14,8" Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1"
              Visibility="{Binding Updates.ShowProgress, Converter={StaticResource BoolToVisibility}}">
        <ContentControl Content="{Binding Updates}" ContentTemplate="{StaticResource ActiveUpdateProgress}" Focusable="False" />
      </Border>
      <Border DockPanel.Dock="Top" Padding="14,6" Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding Updates.ReadyVersion, Converter={StaticResource NullToCollapsed}}" Value="Visible" />
                  <Condition Binding="{Binding Updates.Dismissed}" Value="False" />
                  <Condition Binding="{Binding Updates.IsWorking}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="{Binding Updates.IsRestarting, Converter={StaticResource Not}}">
            <Button Style="{StaticResource Button.Subtle}" Content="Later" Command="{Binding UpdateLaterCommand}" />
            <Button Style="{StaticResource Button.Primary}" Content="Restart now" Command="{Binding RestartToUpdateCommand}" Margin="6,0,0,0" />
          </StackPanel>
          <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock Text="{Binding Updates.Status}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <ProgressBar Height="4" Margin="0,6,0,0" IsIndeterminate="True"
                         Visibility="{Binding Updates.IsRestarting, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </DockPanel>
      </Border>
      <ContentControl Content="{Binding CurrentPage}" Focusable="False"
                      IsEnabled="{Binding Updates.IsRestarting, Converter={StaticResource Not}}" />
    </DockPanel>

    <!-- ───────── Notifications panel ───────── -->
    <Grid Grid.ColumnSpan="3" Visibility="{Binding IsNoticesOpen, Converter={StaticResource BoolToVisibility}}">
      <Border Background="{DynamicResource Brush.Transparent}" MouseLeftButtonDown="OnOverlayClick" />
      <Border Style="{StaticResource Sheet}" Width="400" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="250,0,0,16" MaxHeight="560">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="18,14,12,8">
            <TextBlock Text="Notifications" Style="{StaticResource Text.Title}" />
            <Button Style="{StaticResource Button.Subtle}" Content="Close" ds:Ds.KeyHint="Esc" HorizontalAlignment="Right" Command="{Binding CloseOverlaysCommand}" />
          </Grid>
          <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Notices}" Margin="8,0,8,10">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource Button.Subtle}" HorizontalContentAlignment="Stretch" Padding="10,10" Margin="0,0,0,2"
                            Command="{Binding DataContext.OpenNoticeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="14" />
                          <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,6,0,0" Fill="{Binding Level, Converter={StaticResource NoticeBrush}}" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <StackPanel Margin="18,8,18,24" Visibility="{Binding Notices.Count, Converter={StaticResource PositiveToVisible}, ConverterParameter=invert}">
              <TextBlock Text="All clear" FontWeight="SemiBold" />
              <TextBlock Text="Nothing needs attention: stock and backups are fine." Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>

    <!-- ───────── AI drawer (Ctrl+J): slides over the right edge; the page underneath keeps its size ───────── -->
    <Border x:Name="AiDrawer" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" Width="400" Panel.ZIndex="20"
            Background="{DynamicResource Brush.Background}" BorderBrush="{DynamicResource Brush.LineStrong}" BorderThickness="1,0,0,0"
            Visibility="{Binding IsAssistantOpen, Converter={StaticResource BoolToVisibility}}">
      <Border.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding ToggleAssistantCommand}" />
      </Border.InputBindings>
      <DockPanel>
        <Grid DockPanel.Dock="Top" Height="60" Margin="16,0,10,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Width="30" Height="30">
              <Ellipse Fill="{StaticResource Brush.AiGradient}" />
              <Path Style="{StaticResource AiSpark.White}" Width="15" Height="15" />
            </Grid>
            <TextBlock Text="Ask AI" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Style="{StaticResource Button.Subtle}" Width="36" MinHeight="36" Padding="0" FontFamily="{StaticResource Font.Icons}" FontSize="14" Content="&#xE710;"
                    ToolTip="New chat" Command="{Binding DrawerAssistant.ClearCommand}" Focusable="False" />
            <Button Style="{StaticResource Button.Subtle}" Width="36" MinHeight="36" Padding="0" FontFamily="{StaticResource Font.Icons}" FontSize="13" Content="&#xE711;"
                    ToolTip="Close (Esc or Ctrl+J)" Command="{Binding ToggleAssistantCommand}" Focusable="False" Margin="2,0,0,0" />
          </StackPanel>
        </Grid>
        <ContentControl Content="{Binding DrawerAssistant}">
          <ContentControl.Style>
            <Style TargetType="ContentControl">
              <Style.Triggers>
                <DataTrigger Binding="{Binding DrawerAssistant, Converter={StaticResource NullToCollapsed}}" Value="Visible">
                  <Setter Property="ContentTemplate">
                    <Setter.Value><DataTemplate><assistant:AssistantPanelView /></DataTemplate></Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ContentControl.Style>
        </ContentControl>
      </DockPanel>
    </Border>

    <!-- ───────── Floating AI button (every page) ───────── -->
    <Button Grid.Column="1" Style="{StaticResource AiFab}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,24"
            Command="{Binding ToggleAssistantCommand}" Visibility="{Binding ShowAiButton, Converter={StaticResource BoolToVisibility}}" />

    <!-- ───────── User menu ───────── -->
    <Grid Grid.ColumnSpan="3" Visibility="{Binding IsUserMenuOpen, Converter={StaticResource BoolToVisibility}}">
      <Border Background="{DynamicResource Brush.Transparent}" MouseLeftButtonDown="OnOverlayClick" />
      <Border Style="{StaticResource Sheet}" Width="240" Padding="6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,64">
        <StackPanel>
          <TextBlock Margin="10,8,10,2" Text="{Binding Session.User.FullName}" FontWeight="SemiBold" />
          <TextBlock Margin="10,0,10,8" Style="{StaticResource Text.Caption}">
            <Run Text="@" /><Run Text="{Binding Session.User.Username, Mode=OneWay}" />
          </TextBlock>
          <Border Style="{StaticResource Divider}" Margin="0,0,0,4" />
          <Button Style="{StaticResource MenuItemButton}" Command="{Binding ChangePinCommand}"><TextBlock Text="Change my PIN" /></Button>
          <Button Style="{StaticResource MenuItemButton}" Command="{Binding ShowHelpCommand}" ds:Ds.KeyHint="F1"><TextBlock Text="Keyboard shortcuts" /></Button>
          <Border Style="{StaticResource Divider}" Margin="0,4" />
          <Button Style="{StaticResource MenuItemButton}" Command="{Binding LockCommand}" ds:Ds.KeyHint="Ctrl+L"><TextBlock Text="Lock screen" /></Button>
          <Button Style="{StaticResource MenuItemButton}" Command="{Binding LogoutCommand}" Foreground="{DynamicResource Brush.Danger}"><TextBlock Text="Log out" /></Button>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ───────── Command palette (Ctrl+K): no animation, used many times a day ───────── -->
    <Grid Grid.ColumnSpan="3" Visibility="{Binding IsPaletteOpen, Converter={StaticResource BoolToVisibility}}">
      <Border Background="{DynamicResource Brush.Scrim}" Opacity="0.5" MouseLeftButtonDown="OnOverlayClick" />
      <Border Style="{StaticResource Sheet}" Width="560" Padding="8" VerticalAlignment="Top" Margin="0,96,0,0">
        <DockPanel MaxHeight="460">
          <TextBox x:Name="PaletteBox" DockPanel.Dock="Top" Style="{StaticResource Input.Search}" ds:Ds.Icon="&#xE721;"
                   ds:Ds.Placeholder="Type a screen or an action…" Text="{Binding PaletteText, UpdateSourceTrigger=PropertyChanged}"
                   PreviewKeyDown="OnPaletteKey" />
          <ListBox x:Name="PaletteList" Margin="0,8,0,0" ItemsSource="{Binding PaletteResults}" SelectedItem="{Binding PaletteSelected}"
                   Style="{StaticResource Table}" Focusable="False" MouseUp="OnPaletteClick">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type shell:PaletteCommand}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Title}" FontWeight="Medium" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Section}" Style="{StaticResource Text.Caption}" Margin="12,0" VerticalAlignment="Center" />
                  <Border Grid.Column="2" Style="{StaticResource KeyCap}" Visibility="{Binding Shortcut, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding Shortcut}" Style="{StaticResource KeyCap.Text}" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>

    <!-- ───────── Help (F1) ───────── -->
    <Grid Grid.ColumnSpan="3" Visibility="{Binding IsHelpOpen, Converter={StaticResource BoolToVisibility}}">
      <Border Background="{DynamicResource Brush.Scrim}" MouseLeftButtonDown="OnOverlayClick" />
      <Border Style="{StaticResource Sheet}" Width="860" MaxHeight="640" VerticalAlignment="Center">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Keyboard shortcuts" Style="{StaticResource Text.DialogTitle}" />
            <Button Content="Close" ds:Ds.KeyHint="Esc" HorizontalAlignment="Right" Command="{Binding CloseOverlaysCommand}" />
          </Grid>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{x:Static shell:ShellViewModel.Help}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,24,20">
                    <TextBlock Text="{Binding Item1}" Style="{StaticResource Text.Overline}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Item2}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="130" />
                              <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource KeyCap}" HorizontalAlignment="Left">
                              <TextBlock Text="{Binding Item1}" Style="{StaticResource KeyCap.Text}" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Item2}" TextWrapping="Wrap" VerticalAlignment="Center" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
