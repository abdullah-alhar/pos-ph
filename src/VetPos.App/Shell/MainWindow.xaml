<Window x:Class="VetPos.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:VetPos.App.Shell"
        xmlns:start="clr-namespace:VetPos.App.Features.Start"
        xmlns:controls="clr-namespace:VetPos.App.DesignSystem.Controls"
        Style="{StaticResource AppWindow}"
        Title="VetPOS" Icon="/VetPOS;component/Assets/vetpos.ico"
        Width="1366" Height="768" MinWidth="1024" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
  <Window.Resources>
    <DataTemplate DataType="{x:Type start:SetupViewModel}"><start:SetupView /></DataTemplate>
    <DataTemplate DataType="{x:Type start:LoginViewModel}"><start:LoginView /></DataTemplate>
    <DataTemplate DataType="{x:Type shell:ShellViewModel}"><shell:ShellView /></DataTemplate>
  </Window.Resources>
  <Grid>
    <ContentControl Content="{Binding Screen}" Focusable="False" />
    <start:LockView DataContext="{Binding Lock}" Visibility="{Binding DataContext.IsLocked, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
    <!-- Loading: shown while the till opens after sign-in -->
    <Grid Background="{DynamicResource Brush.Background}" Visibility="{Binding LoadingText, Converter={StaticResource NullToCollapsed}}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid Width="72" Height="72">
          <Image Source="/VetPOS;component/Assets/vetpos-256.png" Visibility="{Binding ShopLogo, Converter={StaticResource NullToVisible}}" />
          <Image Source="{Binding ShopLogo}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
        </Grid>
        <TextBlock Text="{Binding LoadingText}" FontSize="17" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,18,0,12" />
        <ProgressBar IsIndeterminate="True" Width="220" Height="4" />
      </StackPanel>
    </Grid>
    <controls:DialogHost x:Name="Dialogs" />
    <controls:ToastHost x:Name="Toasts" />
  </Grid>
</Window>
