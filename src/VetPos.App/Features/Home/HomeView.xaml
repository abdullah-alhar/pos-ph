<UserControl x:Class="VetPos.App.Features.Home.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VetPos.App.Features.Home">
  <UserControl.Resources>
    <local:NavDescriptionConverter x:Key="NavDesc" />
    <Style x:Key="Metric" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
      <Setter Property="Padding" Value="16,13" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <Style x:Key="MetricValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Title}">
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="{StaticResource Pad.Page}">
      <Grid Margin="0,0,0,22">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Overview" Style="{StaticResource Text.PageTitle}" />
          <TextBlock Text="{Binding TodayText}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource Button.Primary}" Content="New sale" ToolTip="Billing (Ctrl+1)"
                Tag="Billing" Click="QuickAction_Click" VerticalAlignment="Center" MinWidth="112" />
      </Grid>

      <UniformGrid Columns="3" Margin="0,0,-10,24">
        <Border Style="{StaticResource Metric}">
          <StackPanel>
            <TextBlock Text="Sales today" Style="{StaticResource Text.Caption}" />
            <TextBlock Text="{Binding SalesToday, TargetNullValue=—}" Style="{StaticResource MetricValue}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Metric}">
          <StackPanel>
            <TextBlock Text="Bills today" Style="{StaticResource Text.Caption}" />
            <TextBlock Text="{Binding BillsToday, TargetNullValue=—}" Style="{StaticResource MetricValue}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Metric}">
          <StackPanel>
            <TextBlock Text="Low stock" Style="{StaticResource Text.Caption}" />
            <TextBlock Text="{Binding LowStock, TargetNullValue=—}" Style="{StaticResource MetricValue}" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <TextBlock Text="{Binding LoadError}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                 Visibility="{Binding LoadError, Converter={StaticResource NullToCollapsed}}" />
      <TextBlock Text="Workspace" Style="{StaticResource Text.Title}" Margin="0,0,0,10" />
      <ItemsControl x:Name="CardList" Margin="0,0,-10,14">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="{Binding ColumnCount, RelativeSource={RelativeSource AncestorType=local:HomeView}}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=local:HomeView}}"
                    CommandParameter="{Binding}" Margin="0,0,10,10" MinHeight="68"
                    AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Shortcut}">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Surface" CornerRadius="{StaticResource Radius.Card}" Padding="13,9"
                          Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
                    <ContentPresenter />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                      <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
              <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="34" />
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Font.Icons}" FontSize="17"
                           Foreground="{DynamicResource Brush.AccentText}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                  <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Title, Converter={StaticResource NavDesc}}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Shortcut}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <DockPanel LastChildFill="True" Margin="0,4,0,0">
        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Subtle}" Command="{Binding CheckUpdatesCommand}" Content="Check for updates" />
        <TextBlock Text="{Binding Updates.Status}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
