<UserControl x:Class="VetPos.App.Features.Assistant.AssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ds="clr-namespace:VetPos.App.DesignSystem"
             xmlns:local="clr-namespace:VetPos.App.Features.Assistant"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance local:AssistantViewModel}">
  <DockPanel Margin="{StaticResource Pad.Page}" MaxWidth="900">
    <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Path Style="{StaticResource AiSpark}" Width="24" Height="24" Margin="0,0,10,0" />
          <TextBlock Text="AI Assistant" Style="{StaticResource Text.PageTitle}" />
        </StackPanel>
        <TextBlock Text="Ask about sales and inventory, open a screen, or prepare a change for review."
                   Style="{StaticResource Text.Secondary}" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap" />
      </StackPanel>
      <Button Style="{StaticResource Button.Subtle}" Content="New chat" HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding ClearCommand}" />
    </Grid>

    <!-- Offline -->
    <Border DockPanel.Dock="Top" CornerRadius="12" Padding="16,12" Margin="0,0,0,12" Background="{DynamicResource Brush.WarningSoft}"
            Visibility="{Binding Offline, Converter={StaticResource NullToCollapsed}}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource Font.Icons}" FontSize="16" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Top" Margin="0,2,12,0" />
        <StackPanel>
          <TextBlock Text="AI is not ready" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Warning}" />
          <TextBlock Text="{Binding Offline}" TextWrapping="Wrap" Margin="0,2,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Input -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="8" Margin="0,12,0,0">
      <StackPanel>
        <WrapPanel Margin="0,0,0,4">
          <Button Style="{StaticResource Button.Small}" Content="{Binding MicrophoneLabel}" ds:Ds.Icon="&#xE720;"
                  Command="{Binding DictateCommand}" Margin="0,0,6,0" />
          <Button Style="{StaticResource Button.Small}" Content="{Binding ReadAnswerLabel}"
                  Command="{Binding ReadAnswerCommand}" />
        </WrapPanel>
        <TextBlock Text="{Binding VoiceStatus}" TextWrapping="Wrap" Style="{StaticResource Text.Caption}"
                   Margin="4,0,4,6" Visibility="{Binding VoiceStatus, Converter={StaticResource NullToCollapsed}}" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Ask" ds:Ds.KeyHint="Enter" Command="{Binding AskCommand}" VerticalAlignment="Bottom" />
          <TextBox x:Name="InputBox" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Margin="0,0,8,0"
                   ds:Ds.Placeholder="Ask in English, Sinhala or Tamil…" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" />
        </DockPanel>
      </StackPanel>
    </Border>

    <Grid>
      <!-- Empty: suggestions -->
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="Start a conversation" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" Margin="0,0,0,12" />
        <ItemsControl ItemsSource="{Binding Suggestions}" MaxWidth="640">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Content="{Binding}" Margin="4" Command="{Binding DataContext.AskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Conversation -->
      <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Messages}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:ChatMessage}">
                <Border x:Name="Bubble" CornerRadius="14" Padding="16,12" Margin="0,0,80,12" HorizontalAlignment="Left" MaxWidth="680"
                        Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
                  <StackPanel>
                    <TextBlock x:Name="Body" Text="{Binding Text}" TextWrapping="Wrap" FontSize="15" LineHeight="22" />
                    <TextBlock Text="{Binding ToolsUsed}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" Visibility="{Binding ToolsUsed, Converter={StaticResource NullToCollapsed}}" />
                    <ItemsControl ItemsSource="{Binding Actions}" Margin="0,8,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ActionCard}">
                          <Border x:Name="Card" CornerRadius="10" BorderThickness="1.5" BorderBrush="{DynamicResource Brush.Accent}" Background="{DynamicResource Brush.Background}"
                                  Padding="12,10" Margin="0,4,0,0">
                            <StackPanel>
                              <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Icon" Text="&#xE70F;" FontFamily="{StaticResource Font.Icons}" FontSize="13" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="8,0,0,0" TextWrapping="Wrap" />
                              </StackPanel>
                              <ItemsControl ItemsSource="{Binding Lines}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13" Margin="0,1" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <StackPanel x:Name="Buttons" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource Button.Primary}" Content="Confirm" MinHeight="34" Focusable="False"
                                        Command="{Binding DataContext.ConfirmActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                <Button Style="{StaticResource Button.Subtle}" Content="Cancel" MinHeight="34" Margin="6,0,0,0" Focusable="False"
                                        Command="{Binding DataContext.CancelActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                              </StackPanel>
                              <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="3" Margin="0,10,0,0" Visibility="Collapsed" />
                              <TextBlock x:Name="Result" Text="{Binding Result}" TextWrapping="Wrap" FontWeight="Medium" Margin="0,8,0,0"
                                         Visibility="{Binding Result, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>
                          </Border>
                          <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsWaiting}" Value="False">
                              <Setter TargetName="Buttons" Property="Visibility" Value="Collapsed" />
                              <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="busy">
                              <Setter TargetName="Busy" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="done">
                              <Setter TargetName="Icon" Property="Text" Value="&#xE73E;" />
                              <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Brush.Success}" />
                              <Setter TargetName="Result" Property="Foreground" Value="{DynamicResource Brush.Success}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="failed">
                              <Setter TargetName="Icon" Property="Text" Value="&#xE783;" />
                              <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                              <Setter TargetName="Result" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="cancelled">
                              <Setter TargetName="Card" Property="Opacity" Value="0.6" />
                            </DataTrigger>
                          </DataTemplate.Triggers>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Links}" Margin="0,8,0,0">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Style="{StaticResource Button.Small}" Content="{Binding Label}" Margin="0,0,6,6" ds:Ds.Icon="&#xE8A7;"
                                  Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding FromUser}" Value="True">
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="Bubble" Property="Margin" Value="80,0,0,12" />
                    <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                    <Setter TargetName="Bubble" Property="BorderThickness" Value="0" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
                    <Setter TargetName="Bubble" Property="BorderThickness" Value="0" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Margin="4,0,0,12" Visibility="{Binding IsThinking, Converter={StaticResource BoolToVisibility}}">
            <ProgressBar IsIndeterminate="True" Width="80" Height="4" VerticalAlignment="Center" />
            <TextBlock Text="Looking at your data…" Style="{StaticResource Text.Secondary}" Margin="10,0,0,0" VerticalAlignment="Center" />
            <Button Style="{StaticResource Button.Small}" Content="Stop" Command="{Binding AskCancelCommand}" Margin="8,0,0,0" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
