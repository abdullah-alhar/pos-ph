<UserControl x:Class="VetPos.App.Features.Billing.BillingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ds="clr-namespace:VetPos.App.DesignSystem"
             xmlns:controls="clr-namespace:VetPos.App.DesignSystem.Controls"
             xmlns:data="clr-namespace:VetPos.Data.Services;assembly=VetPos.Data"
             xmlns:local="clr-namespace:VetPos.App.Features.Billing"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance local:BillingViewModel}">
  <UserControl.InputBindings>
    <KeyBinding Key="F12" Command="{Binding PayCommand}" />
    <KeyBinding Key="F3" Command="{Binding EditQtyCommand}" />
    <KeyBinding Key="F4" Command="{Binding EditPriceCommand}" />
    <KeyBinding Key="F5" Command="{Binding LineDiscountCommand}" />
    <KeyBinding Key="F6" Command="{Binding BillDiscountEditCommand}" />
    <KeyBinding Key="F8" Command="{Binding HoldCommand}" />
    <KeyBinding Key="F9" Command="{Binding RecallCommand}" />
    <KeyBinding Key="F10" Command="{Binding ReprintLastCommand}" />
    <KeyBinding Key="F7" Command="{Binding PastBillsCommand}" />
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewBillCommand}" />
  </UserControl.InputBindings>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="360" />
    </Grid.ColumnDefinitions>

    <!-- ───────── Left: scan, bill, keys ───────── -->
    <DockPanel Margin="20,18,20,14">
      <Grid DockPanel.Dock="Top" Margin="0,0,0,14" Panel.ZIndex="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="1" Margin="12,0,0,0" Height="48" Padding="14,0" Focusable="False" Click="OnAskAi" ToolTip="Ask AI (Ctrl+J)">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource AiSpark}" Width="18" Height="18" />
            <TextBlock Text="Ask AI" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <TextBox x:Name="ScanBox" Style="{StaticResource Input.Search}" ds:Ds.Placeholder="Scan a barcode or type a product name"
                 ds:Ds.KeyHint="F2" ds:Ds.Error="{Binding SearchError}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="Scan or search" />
        <!-- Suggestions under the box: big, calm rows; name, stock and price readable at a glance -->
        <Popup IsOpen="{Binding ShowSuggestions}" PlacementTarget="{Binding ElementName=ScanBox}" Placement="Bottom" VerticalOffset="8"
               Width="{Binding ActualWidth, ElementName=ScanBox}" AllowsTransparency="True" StaysOpen="True" Focusable="False">
          <Border Style="{StaticResource Sheet.Flat}" Padding="6">
            <DockPanel>
              <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="12,8,12,4" Margin="0,4,0,0">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}">
                    <Run Text="{Binding Suggestions.Count, Mode=OneWay}" /><Run Text=" found" />
                  </TextBlock>
                  <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource KeyCap}"><TextBlock Style="{StaticResource KeyCap.Text}" Text="↑↓" /></Border>
                    <TextBlock Text="choose" Style="{StaticResource Text.Caption}" Margin="6,0,14,0" VerticalAlignment="Center" />
                    <Border Style="{StaticResource KeyCap}"><TextBlock Style="{StaticResource KeyCap.Text}" Text="Enter" /></Border>
                    <TextBlock Text="add to bill" Style="{StaticResource Text.Caption}" Margin="6,0,14,0" VerticalAlignment="Center" />
                    <Border Style="{StaticResource KeyCap}"><TextBlock Style="{StaticResource KeyCap.Text}" Text="Esc" /></Border>
                    <TextBlock Text="close" Style="{StaticResource Text.Caption}" Margin="6,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                </DockPanel>
              </Border>
              <ListBox x:Name="SuggestionList" ItemsSource="{Binding Suggestions}" SelectedItem="{Binding Suggestion}" MaxHeight="520"
                       Focusable="False" PreviewMouseLeftButtonUp="OnSuggestionClick" BorderThickness="0" Background="Transparent"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="Root" CornerRadius="10" Padding="14,10" Margin="0,1" Background="Transparent" MinHeight="64">
                            <Grid>
                              <Border x:Name="Bar" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="-10,4,0,4" Background="{DynamicResource Brush.Accent}" Visibility="Collapsed" />
                              <ContentPresenter VerticalAlignment="Center" />
                            </Grid>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                              <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type data:ProductRow}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" MinWidth="130" />
                      </Grid.ColumnDefinitions>
                      <!-- Kind icon -->
                      <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Brush.SurfaceSunken}" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock x:Name="Kind" Text="&#xE7BF;" FontFamily="{StaticResource Font.Icons}" FontSize="17" Foreground="{DynamicResource Brush.Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                          <TextBlock Text="{Binding Category}" Style="{StaticResource Text.Secondary}" />
                          <TextBlock x:Name="Generic" Style="{StaticResource Text.Secondary}" Visibility="Collapsed">
                            <Run Text="  ·  " /><Run Text="{Binding GenericName, Mode=OneWay}" />
                          </TextBlock>
                          <TextBlock x:Name="Code" Style="{StaticResource Text.Secondary}" FontFamily="{StaticResource Font.Mono}">
                            <Run Text="  ·  " /><Run Text="{Binding Barcode, Mode=OneWay}" />
                          </TextBlock>
                        </StackPanel>
                      </StackPanel>
                      <!-- Stock -->
                      <Grid Grid.Column="2" Margin="14,0" VerticalAlignment="Center">
                        <Border x:Name="InStock" Style="{StaticResource Badge.Success}">
                          <TextBlock><Run Text="{Binding SellableQty, Mode=OneWay}" /><Run Text=" in stock" /></TextBlock>
                        </Border>
                        <Border x:Name="Low" Style="{StaticResource Badge.Warning}" Visibility="Collapsed">
                          <TextBlock><Run Text="Only " /><Run Text="{Binding SellableQty, Mode=OneWay}" /><Run Text=" left" /></TextBlock>
                        </Border>
                        <Border x:Name="Out" Style="{StaticResource Badge.Danger}" Visibility="Collapsed">
                          <TextBlock Text="Out of stock" />
                        </Border>
                      </Grid>
                      <TextBlock Grid.Column="3" Text="{Binding SellingPrice, Converter={StaticResource Money}}" FontSize="20" FontWeight="Bold"
                                 Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsMedicine}" Value="True">
                        <Setter TargetName="Kind" Property="Text" Value="&#xE95E;" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding GenericName, Converter={StaticResource NullToCollapsed}}" Value="Visible">
                        <Setter TargetName="Generic" Property="Visibility" Value="Visible" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Barcode}" Value="{x:Null}">
                        <Setter TargetName="Code" Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                        <Setter TargetName="InStock" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Low" Property="Visibility" Value="Visible" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsOut}" Value="True">
                        <Setter TargetName="InStock" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Low" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Out" Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>
        </Popup>
      </Grid>

      <!-- Keys -->
      <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
        <WrapPanel.Resources>
          <Style TargetType="Button" BasedOn="{StaticResource Button.Subtle}">
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Padding" Value="10,0,10,0" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Focusable" Value="False" />
          </Style>
        </WrapPanel.Resources>
        <Button Content="Qty" ds:Ds.KeyHint="F3" Command="{Binding EditQtyCommand}" />
        <Button Content="Price" ds:Ds.KeyHint="F4" Command="{Binding EditPriceCommand}" />
        <Button Content="Discount" ds:Ds.KeyHint="F5" Command="{Binding LineDiscountCommand}" />
        <Button Content="Bill discount" ds:Ds.KeyHint="F6" Command="{Binding BillDiscountEditCommand}" />
        <Button Content="Remove" ds:Ds.KeyHint="Del" Command="{Binding RemoveLineCommand}" />
        <Button Content="Past bills" ds:Ds.KeyHint="F7" Command="{Binding PastBillsCommand}" />
        <Button Content="Reprint" ds:Ds.KeyHint="F10" Command="{Binding ReprintLastCommand}" />
        <Button Content="All keys" ds:Ds.KeyHint="F1" Click="OnHelp" />
      </WrapPanel>

      <!-- Changing an old bill -->
      <Border DockPanel.Dock="Top" CornerRadius="10" Padding="14,10" Margin="0,0,0,10" Background="{DynamicResource Brush.WarningSoft}"
              Visibility="{Binding ChangingBill, Converter={StaticResource NullToCollapsed}}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE70F;" FontFamily="{StaticResource Font.Icons}" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ChangingBill}" Foreground="{DynamicResource Brush.Warning}" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- Bill lines -->
      <Border Style="{StaticResource Card}" Padding="0">
        <Grid>
          <DockPanel Visibility="{Binding HasLines, Converter={StaticResource BoolToVisibility}}">
            <Border DockPanel.Dock="Top" Style="{StaticResource TableHeader}" CornerRadius="14,14,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="36" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition Width="136" />
                  <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="#" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="Item" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="Price" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" />
                <TextBlock Grid.Column="3" Text="Qty" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Grid.Column="4" Text="Total" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" />
              </Grid>
            </Border>
            <ListBox x:Name="LinesList" Style="{StaticResource Table}" ItemsSource="{Binding Lines}" SelectedItem="{Binding Selected}" Focusable="False"
                     MouseDoubleClick="OnLineDoubleClick">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:CartLine}">
                  <Grid Margin="-16,0,-16,0" ds:Ds.Flash="{Binding Flash}">
                    <Grid Margin="16,12,16,12" MinHeight="44">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="136" />
                        <ColumnDefinition Width="130" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Number}" Style="{StaticResource Text.Caption}" FontSize="14" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="17" TextTrimming="CharacterEllipsis" />
                        <WrapPanel Margin="0,4,0,0">
                          <TextBlock Text="{Binding Barcode}" Style="{StaticResource Text.Caption}" FontSize="13" FontFamily="{StaticResource Font.Mono}" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Visibility="{Binding Barcode, Converter={StaticResource NullToCollapsed}}" />
                          <Border Style="{StaticResource Badge.Warning}" Margin="0,1,6,1" Visibility="{Binding PriceChanged, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding PriceChangeText}" />
                          </Border>
                          <Border Style="{StaticResource Badge.Success}" Margin="0,1,6,1" Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding DiscountText}" />
                          </Border>
                        </WrapPanel>
                      </StackPanel>
                      <TextBox Grid.Column="2" Style="{StaticResource InlineEdit}" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="100" FontSize="17" FontWeight="SemiBold"
                               Text="{Binding UnitPrice, Mode=OneWay, Converter={StaticResource Money}}"
                               GotKeyboardFocus="OnPriceFocus" PreviewKeyDown="OnPriceKey" LostKeyboardFocus="OnPriceCommit" />
                      <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Style="{StaticResource Button.Icon}" Content="−" Focusable="False" Click="OnMinus" Width="36" Height="36" FontSize="16" />
                        <TextBlock Text="{Binding Qty}" Width="44" TextAlignment="Center" VerticalAlignment="Center" FontSize="17" FontWeight="Bold" />
                        <Button Style="{StaticResource Button.Icon}" Content="+" Focusable="False" Click="OnPlus" Width="36" Height="36" FontSize="16" />
                      </StackPanel>
                      <TextBlock Grid.Column="4" Text="{Binding Total, Converter={StaticResource Money}}" Style="{StaticResource Text.MoneyStrong}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                    </Grid>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
          <controls:StateView Icon="&#xEE6F;" Title="Scan an item to start the bill" Message="or type its name or barcode in the box above, then press Enter."
                              Visibility="{Binding HasLines, Converter={StaticResource InverseBoolToVisibility}}" />
        </Grid>
      </Border>
    </DockPanel>

    <!-- ───────── Right: totals and actions ───────── -->
    <Border Grid.Column="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1,0,0,0">
      <Grid>
        <!-- Bill -->
        <DockPanel Visibility="{Binding ShowSuccess, Converter={StaticResource InverseBoolToVisibility}}">
          <StackPanel DockPanel.Dock="Bottom" Margin="16" >
            <!-- The total: the hero of the screen -->
            <Border CornerRadius="16" Background="{DynamicResource Brush.Accent}" Padding="20,16,20,18" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="Total" FontSize="17" FontWeight="SemiBold" Foreground="White" Opacity="0.85" />
                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,2,0,0">
                  <TextBlock FontSize="52" FontWeight="Bold" Foreground="White" Typography.NumeralAlignment="Tabular">
                    <Run Text="Rs" FontSize="24" FontWeight="Medium" Foreground="White" /> <Run Text="{Binding Totals.Total, Mode=OneWay, Converter={StaticResource Money}}" />
                  </TextBlock>
                </Viewbox>
              </StackPanel>
            </Border>
            <Button Style="{StaticResource Button.Pay}" Command="{Binding PayCommand}" Focusable="False" HorizontalContentAlignment="Center"
                    ds:Ds.KeyHint="F12" IsEnabled="{Binding HasLines}">
              <TextBlock Text="{Binding PayText}" />
            </Button>
            <UniformGrid Columns="2" Margin="0,8,0,0">
              <Button Content="Discount" ds:Ds.KeyHint="F6" Command="{Binding BillDiscountEditCommand}" Margin="0,0,4,8" Focusable="False" IsEnabled="{Binding HasLines}" />
              <Button Content="Hold" ds:Ds.KeyHint="F8" Command="{Binding HoldCommand}" Margin="4,0,0,8" Focusable="False" IsEnabled="{Binding HasLines}" />
              <Button Command="{Binding RecallCommand}" Margin="0,0,4,0" Focusable="False" ds:Ds.KeyHint="F9">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Bills" />
                  <Border CornerRadius="8" Background="{DynamicResource Brush.Accent}" Padding="6,0" Margin="6,0,0,0"
                          Visibility="{Binding HeldCount, Converter={StaticResource PositiveToVisible}}">
                    <TextBlock Text="{Binding HeldCount}" Foreground="{DynamicResource Brush.OnAccent}" FontSize="13" />
                  </Border>
                </StackPanel>
              </Button>
              <Button Content="New" ds:Ds.KeyHint="Ctrl+N" Command="{Binding NewBillCommand}" Margin="4,0,0,0" Focusable="False" />
            </UniformGrid>
          </StackPanel>

          <StackPanel Margin="20,20,20,0" DockPanel.Dock="Top">
            <TextBlock FontWeight="SemiBold" FontSize="15">
              <Run Text="Current bill" /> <Run Text="·" Foreground="{DynamicResource Brush.TextSecondary}" />
              <Run Text="{Binding CountText, Mode=OneWay}" FontWeight="Normal" Foreground="{DynamicResource Brush.TextSecondary}" />
            </TextBlock>
            <Grid Margin="0,14,0,0">
              <TextBlock Text="Subtotal" Style="{StaticResource Text.Secondary}" FontSize="14" />
              <TextBlock Text="{Binding Totals.Subtotal, Converter={StaticResource Money}}" Style="{StaticResource Text.Money}" HorizontalAlignment="Right" />
            </Grid>
            <Grid Margin="0,8,0,0" Visibility="{Binding HasLineDiscounts, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="Item discounts" Style="{StaticResource Text.Secondary}" FontSize="14" />
              <TextBlock Style="{StaticResource Text.Money}" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.Success}">
                <Run Text="−" /><Run Text="{Binding Totals.LineDiscountTotal, Mode=OneWay, Converter={StaticResource Money}}" />
              </TextBlock>
            </Grid>
            <Grid Margin="0,8,0,0" Visibility="{Binding HasBillDiscount, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{Binding BillDiscountLabel}" Style="{StaticResource Text.Secondary}" FontSize="14" />
              <TextBlock Style="{StaticResource Text.Money}" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.Success}">
                <Run Text="−" /><Run Text="{Binding Totals.BillDiscountAmount, Mode=OneWay, Converter={StaticResource Money}}" />
              </TextBlock>
            </Grid>
          </StackPanel>

          <Grid />
        </DockPanel>

        <!-- Saved: the change is the biggest thing (old ShopPOS) -->
        <StackPanel VerticalAlignment="Center" Margin="24" Visibility="{Binding ShowSuccess, Converter={StaticResource BoolToVisibility}}">
          <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource Brush.SuccessSoft}" HorizontalAlignment="Center">
            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Font.Icons}" FontSize="28" Foreground="{DynamicResource Brush.Success}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock HorizontalAlignment="Center" Margin="0,12,0,0" Style="{StaticResource Text.Secondary}" FontSize="14">
            <Run Text="Bill #" /><Run Text="{Binding LastSale.Number, Mode=OneWay}" /> <Run Text="saved" />
          </TextBlock>
          <TextBlock Text="Change" Style="{StaticResource Text.Overline}" HorizontalAlignment="Center" Margin="0,18,0,0" FontSize="13"
                     Visibility="{Binding LastSale.Change, Converter={StaticResource PositiveToVisible}}" />
          <Viewbox StretchDirection="DownOnly" Margin="0,2,0,0" Visibility="{Binding LastSale.Change, Converter={StaticResource PositiveToVisible}}">
            <TextBlock Style="{StaticResource Text.Total}" TextAlignment="Center">
              <Run Text="Rs" FontSize="26" Foreground="{DynamicResource Brush.TextSecondary}" /> <Run Text="{Binding LastSale.Change, Mode=OneWay, Converter={StaticResource Money}}" />
            </TextBlock>
          </Viewbox>
          <TextBlock HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="20" FontWeight="SemiBold">
            <Run Text="Total" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="Normal" /> <Run Text="{Binding LastSale.Total, Mode=OneWay, Converter={StaticResource MoneyWithSymbol}}" />
          </TextBlock>
          <TextBlock Text="Scan the next item to start a new bill" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" Margin="0,18,0,0" />
          <Button Content="Print again" ds:Ds.KeyHint="F10" Command="{Binding ReprintLastCommand}" Margin="0,18,0,0" Focusable="False" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
