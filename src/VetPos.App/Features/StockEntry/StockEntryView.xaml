<UserControl x:Class="VetPos.App.Features.StockEntry.StockEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ds="clr-namespace:VetPos.App.DesignSystem"
             xmlns:controls="clr-namespace:VetPos.App.DesignSystem.Controls"
             xmlns:data="clr-namespace:VetPos.Data.Services;assembly=VetPos.Data"
             xmlns:local="clr-namespace:VetPos.App.Features.StockEntry"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance local:StockEntryViewModel}">
  <UserControl.InputBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
  </UserControl.InputBindings>
  <Grid Margin="{StaticResource Pad.Page}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="300" />
    </Grid.ColumnDefinitions>

    <DockPanel Margin="0,0,24,0">
      <StackPanel DockPanel.Dock="Top">
        <TextBlock Text="Stock in" Style="{StaticResource Text.PageTitle}" />
        <TextBlock Text="Add goods when they arrive. Stock changes only when you save." Style="{StaticResource Text.Secondary}" FontSize="14" Margin="0,4,0,20" />
      </StackPanel>

      <!-- Header -->
      <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,16">
        <Grid ds:Ds.EnterNext="True">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="160" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Supplier (optional)" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding Supplier}" DisplayMemberPath="Name" MinHeight="40" IsEditable="False" />
          </StackPanel>
          <Button Grid.Column="1" Content="New supplier" Margin="8,0,16,0" VerticalAlignment="Bottom" Command="{Binding NewSupplierCommand}" />
          <StackPanel Grid.Column="2" Margin="0,0,16,0">
            <TextBlock Text="Invoice no. (optional)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding InvoiceNo, UpdateSourceTrigger=PropertyChanged}" ds:Ds.Placeholder="e.g. INV-2231" />
          </StackPanel>
          <StackPanel Grid.Column="3">
            <TextBlock Text="Invoice date" Style="{StaticResource FieldLabel}" />
            <DatePicker SelectedDate="{Binding InvoiceDate}" MinHeight="40" SelectedDateFormat="Short" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Save bar -->
      <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,14">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource Text.Secondary}" FontSize="14" VerticalAlignment="Center">
              <Run Text="{Binding Lines.Count, Mode=OneWay}" /> <Run Text="line(s) ·" /> <Run Text="{Binding Units, Mode=OneWay}" /> <Run Text="units ·" />
            </TextBlock>
            <TextBlock Text="{Binding Total, Converter={StaticResource MoneyWithSymbol}}" FontSize="20" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <Button Style="{StaticResource Button.Primary}" Content="Save delivery" ds:Ds.KeyHint="Ctrl+S" HorizontalAlignment="Right" MinHeight="44"
                  Command="{Binding SaveCommand}" IsEnabled="{Binding HasLines}" />
        </Grid>
      </Border>

      <!-- Lines -->
      <Border Style="{StaticResource Card}" Padding="0">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="16,16,16,12" Panel.ZIndex="5">
            <TextBox x:Name="SearchBox" Style="{StaticResource Input.Search}" ds:Ds.Placeholder="Scan or type a product to add it" ds:Ds.Error="{Binding SearchError}"
                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="OnSearchKey" />
            <Popup IsOpen="{Binding ShowSuggestions}" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" VerticalOffset="6"
                   Width="{Binding ActualWidth, ElementName=SearchBox}" AllowsTransparency="True" StaysOpen="True" Focusable="False">
              <Border Style="{StaticResource Sheet.Flat}" Padding="4" MaxHeight="360">
                <ListBox x:Name="SuggestionList" ItemsSource="{Binding Suggestions}" SelectedItem="{Binding Suggestion}" Style="{StaticResource Table}" Focusable="False"
                         PreviewMouseLeftButtonUp="OnSuggestionClick">
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type data:ProductRow}">
                      <Grid>
                        <TextBlock Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center" />
                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center">
                          <Run Text="{Binding StockQty, Mode=OneWay}" /> <Run Text="in stock" />
                        </TextBlock>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>
            </Popup>
          </Grid>
          <Border DockPanel.Dock="Top" Style="{StaticResource TableHeader}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="104" />
                <ColumnDefinition Width="104" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="104" />
                <ColumnDefinition Width="42" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Product" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Qty" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="Cost" VerticalAlignment="Center" />
              <TextBlock Grid.Column="3" Text="Selling" VerticalAlignment="Center" />
              <TextBlock Grid.Column="4" Text="Expiry date" VerticalAlignment="Center" />
              <TextBlock Grid.Column="5" Text="Total" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
          </Border>
          <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="LineList" ItemsSource="{Binding Lines}" KeyboardNavigation.TabNavigation="Continue">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type local:ReceiptLineRow}">
                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Line}" Padding="16,10">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="76" />
                          <ColumnDefinition Width="104" />
                          <ColumnDefinition Width="104" />
                          <ColumnDefinition Width="170" />
                          <ColumnDefinition Width="104" />
                          <ColumnDefinition Width="42" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                          <TextBlock Text="{Binding Name}" FontWeight="Medium" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding MarginText}" Style="{StaticResource Text.Caption}" />
                          <TextBox Text="{Binding BatchNo, UpdateSourceTrigger=PropertyChanged}" ds:Ds.Placeholder="Batch no. (optional)" MinHeight="34" FontSize="14"
                                   Margin="0,6,0,0" MaxWidth="200" HorizontalAlignment="Left" Width="200" />
                          <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" FontSize="13" TextWrapping="Wrap"
                                     Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>
                        <TextBox x:Name="QtyBox" Grid.Column="1" Style="{StaticResource Input.Number}" Text="{Binding Qty, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                        <TextBox Grid.Column="2" Style="{StaticResource Input.Number}" Text="{Binding Cost, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                        <TextBox Grid.Column="3" Style="{StaticResource Input.Number}" Text="{Binding Selling, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                        <StackPanel Grid.Column="4" Margin="0,0,6,0" VerticalAlignment="Center">
                          <DatePicker SelectedDate="{Binding Expiry}" MinHeight="40" SelectedDateFormat="Short" ToolTip="The expiry date printed on the pack. Leave empty if it does not expire." />
                          <TextBlock Text="{Binding ExpiryHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="2,3,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="5" Text="{Binding LineTotal, Converter={StaticResource Money}}" Style="{StaticResource Text.MoneyStrong}" VerticalAlignment="Center" />
                        <Button Grid.Column="6" Style="{StaticResource Button.Icon}" Content="&#xE711;" FontFamily="{StaticResource Font.Icons}" FontSize="13"
                                Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                ToolTip="Remove line" IsTabStop="False" HorizontalAlignment="Right" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <controls:StateView Icon="&#xE7B8;" Title="No items yet" Message="Scan or search a product above, then type the quantity and prices."
                                Visibility="{Binding HasLines, Converter={StaticResource InverseBoolToVisibility}}" />
          </Grid>
        </DockPanel>
      </Border>
    </DockPanel>

    <!-- Recent deliveries -->
    <DockPanel Grid.Column="1">
      <TextBlock DockPanel.Dock="Top" Text="Recent deliveries" Style="{StaticResource Text.Overline}" Margin="0,64,0,10" />
      <Border Style="{StaticResource Card}" Padding="0">
        <Grid>
          <ListBox ItemsSource="{Binding Recent}" Style="{StaticResource Table}" Focusable="False">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type data:ReceiptRow}">
                <StackPanel Margin="0,6">
                  <Grid>
                    <TextBlock Text="{Binding Number}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Total, Converter={StaticResource Money}}" HorizontalAlignment="Right" Style="{StaticResource Text.Money}" />
                  </Grid>
                  <TextBlock Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Supplier, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding InvoiceDate, Mode=OneWay, Converter={StaticResource Date}}" />
                  </TextBlock>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <controls:StateView Icon="&#xE7B8;" Title="No deliveries yet" Message="Saved deliveries appear here."
                              Visibility="{Binding Recent.Count, Converter={StaticResource PositiveToVisible}, ConverterParameter=invert}" />
        </Grid>
      </Border>
    </DockPanel>
  </Grid>
</UserControl>
