<UserControl x:Class="VetPos.App.Features.Reports.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ds="clr-namespace:VetPos.App.DesignSystem"
             xmlns:controls="clr-namespace:VetPos.App.DesignSystem.Controls"
             xmlns:data="clr-namespace:VetPos.Data.Services;assembly=VetPos.Data"
             xmlns:local="clr-namespace:VetPos.App.Features.Reports"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance local:ReportsViewModel}">
  <UserControl.Resources>
    <Style x:Key="Th" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ThR" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
  </UserControl.Resources>

  <DockPanel Margin="{StaticResource Pad.Page}">
    <!-- Header -->
    <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="Reports" Style="{StaticResource Text.PageTitle}" />
        <TextBlock Text="{Binding SectionTitle}" Style="{StaticResource Text.Secondary}" FontSize="14" Margin="0,4,0,0" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Content="Export PDF" ds:Ds.Icon="&#xE749;" Command="{Binding ExportCommand}" CommandParameter="pdf" Margin="0,0,8,0" />
        <Button Content="Export Excel" ds:Ds.Icon="&#xE9F9;" Command="{Binding ExportCommand}" CommandParameter="xlsx" />
      </StackPanel>
    </Grid>

    <!-- Section menu on the left (no tabs across the top) -->
    <ScrollViewer DockPanel.Dock="Left" Width="230" Margin="0,0,24,0" VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel>
        <TextBlock Text="Money" Style="{StaticResource Text.Overline}" Margin="12,0,0,8" />
        <RadioButton Style="{StaticResource SideTab}" ds:Ds.Icon="&#xE8BF;" Content="Today" IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Today}" />
        <RadioButton Style="{StaticResource SideTab}" ds:Ds.Icon="&#xE9D2;" Content="Sales" IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Sales}" />
        <RadioButton Style="{StaticResource SideTab}" ds:Ds.Icon="&#xE8C7;" Content="Profit" IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Profit}"
                     Visibility="{Binding IsOwner, Converter={StaticResource BoolToVisibility}}" />
        <RadioButton Style="{StaticResource SideTab}" ds:Ds.Icon="&#xE8A1;" Content="Bills" IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Bills}" />
        <TextBlock Text="Stock" Style="{StaticResource Text.Overline}" Margin="12,18,0,8" />
        <RadioButton Style="{StaticResource SideTab}" ds:Ds.Icon="&#xE7B8;" Content="Stock value" IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Stock}" />
        <RadioButton Style="{StaticResource SideTab}" ds:Ds.Icon="&#xE7BA;" Content="Low stock &amp; expiry" IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=LowStockExpiry}" />
        <TextBlock Text="Control" Style="{StaticResource Text.Overline}" Margin="12,18,0,8" />
        <RadioButton Style="{StaticResource SideTab}" ds:Ds.Icon="&#xE8EC;" Content="Discounts &amp; prices" IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Changes}" />
        <RadioButton Style="{StaticResource SideTab}" ds:Ds.Icon="&#xE81C;" Content="Activity log" IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Activity}"
                     Visibility="{Binding IsOwner, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </ScrollViewer>

    <!-- Dates -->
    <!-- Sales: one tap for day / week / month / year, arrows to go back and forward -->
    <Grid DockPanel.Dock="Top" Margin="0,0,0,16" Visibility="{Binding Section, Converter={StaticResource EqualsVisible}, ConverterParameter=Sales}">
      <Border CornerRadius="12" Padding="4" Background="{DynamicResource Brush.SurfaceSubtle}" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal">
          <RadioButton Style="{StaticResource Segment}" Content="Day" MinWidth="76" IsChecked="{Binding Period, Converter={StaticResource Equals}, ConverterParameter=Day}" />
          <RadioButton Style="{StaticResource Segment}" Content="Week" MinWidth="76" IsChecked="{Binding Period, Converter={StaticResource Equals}, ConverterParameter=Week}" />
          <RadioButton Style="{StaticResource Segment}" Content="Month" MinWidth="76" IsChecked="{Binding Period, Converter={StaticResource Equals}, ConverterParameter=Month}" />
          <RadioButton Style="{StaticResource Segment}" Content="Year" MinWidth="76" IsChecked="{Binding Period, Converter={StaticResource Equals}, ConverterParameter=Year}" />
          <RadioButton Style="{StaticResource Segment}" Content="Pick dates" IsChecked="{Binding Period, Converter={StaticResource Equals}, ConverterParameter=Custom}" />
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Style="{StaticResource Button.Icon}" Width="46" MinHeight="46" Content="&#xE76B;" FontFamily="{StaticResource Font.Icons}" FontSize="16"
                Command="{Binding StepCommand}" CommandParameter="back" ToolTip="Before" />
        <TextBlock Text="{Binding PeriodTitle}" Style="{StaticResource Text.Title}" VerticalAlignment="Center" MinWidth="220" TextAlignment="Center" Margin="12,0" />
        <Button Style="{StaticResource Button.Icon}" Width="46" MinHeight="46" Content="&#xE76C;" FontFamily="{StaticResource Font.Icons}" FontSize="16"
                Command="{Binding StepCommand}" CommandParameter="next" ToolTip="After" />
      </StackPanel>
    </Grid>

    <!-- Sales: one product only (search), or the whole shop -->
    <Grid DockPanel.Dock="Top" Margin="0,0,0,16" Panel.ZIndex="5" Visibility="{Binding Section, Converter={StaticResource EqualsVisible}, ConverterParameter=Sales}">
      <Grid Visibility="{Binding HasSalesProduct, Converter={StaticResource InverseBoolToVisibility}}" MaxWidth="560" HorizontalAlignment="Left">
        <TextBox x:Name="ProductSearchBox" Style="{StaticResource Input.Search}" Width="520" ds:Ds.Placeholder="See one product's sales: type its name or scan it"
                 Text="{Binding ProductSearch, UpdateSourceTrigger=PropertyChanged, Delay=200}">
          <TextBox.InputBindings>
            <KeyBinding Key="Enter" Command="{Binding PickFirstProductCommand}" />
          </TextBox.InputBindings>
        </TextBox>
        <Popup IsOpen="{Binding ShowProductSuggestions}" PlacementTarget="{Binding ElementName=ProductSearchBox}" Placement="Bottom" VerticalOffset="6"
               Width="{Binding ActualWidth, ElementName=ProductSearchBox}" AllowsTransparency="True" StaysOpen="False" Focusable="False">
          <Border Style="{StaticResource Sheet.Flat}" Padding="4" MaxHeight="380">
            <ListBox ItemsSource="{Binding ProductSuggestions}" SelectedItem="{Binding PickedSuggestion}" Style="{StaticResource Table}" Focusable="False">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type data:ProductRow}">
                  <Grid>
                    <TextBlock Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,90,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center">
                      <Run Text="{Binding StockQty, Mode=OneWay}" /> <Run Text="in stock" />
                    </TextBlock>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </Popup>
      </Grid>
      <!-- Chosen product: a clear chip with a big X to go back to all products -->
      <Border Visibility="{Binding HasSalesProduct, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Left"
              Background="{DynamicResource Brush.AccentSoft}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1" CornerRadius="12" Padding="14,6,6,6">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE7BF;" FontFamily="{StaticResource Font.Icons}" FontSize="20" Foreground="{DynamicResource Brush.AccentText}" VerticalAlignment="Center" />
          <TextBlock Margin="10,0,14,0" VerticalAlignment="Center" FontSize="16">
            <Run Text="Only:" Foreground="{DynamicResource Brush.TextSecondary}" /> <Run Text="{Binding SalesProduct.Name, Mode=OneWay}" FontWeight="SemiBold" />
          </TextBlock>
          <Button Style="{StaticResource Button.Primary}" ds:Ds.Icon="&#xE711;" Content="All products" MinHeight="38" Command="{Binding ClearProductCommand}" />
        </StackPanel>
      </Border>
    </Grid>

    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,16" Visibility="{Binding ShowDatePickers, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="From" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
      <DatePicker SelectedDate="{Binding From}" Width="150" MinHeight="40" />
      <TextBlock Text="to" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="12,0,8,0" />
      <DatePicker SelectedDate="{Binding To}" Width="150" MinHeight="40" />
      <Button Style="{StaticResource Button.Subtle}" Content="Today" Command="{Binding PresetCommand}" CommandParameter="today" Margin="16,0,0,0" />
      <Button Style="{StaticResource Button.Subtle}" Content="Yesterday" Command="{Binding PresetCommand}" CommandParameter="yesterday" />
      <Button Style="{StaticResource Button.Subtle}" Content="This week" Command="{Binding PresetCommand}" CommandParameter="week" />
      <Button Style="{StaticResource Button.Subtle}" Content="This month" Command="{Binding PresetCommand}" CommandParameter="month" />
      <Button Style="{StaticResource Button.Subtle}" Content="Last month" Command="{Binding PresetCommand}" CommandParameter="lastmonth" />
    </WrapPanel>

    <!-- Tiles -->
    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Tiles}" Margin="0,0,0,16">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type local:Tile}">
          <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18,14">
            <StackPanel>
              <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Secondary}" FontSize="15" />
              <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Value}" FontSize="30" FontWeight="Bold" Margin="0,4,0,0" Typography.NumeralAlignment="Tabular" />
              </Viewbox>
              <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Caption}" Visibility="{Binding Hint, Converter={StaticResource NullToCollapsed}}" />
              <TextBlock x:Name="Trend" Text="{Binding Trend}" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"
                         Foreground="{DynamicResource Brush.Success}" Visibility="{Binding Trend, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>
          </Border>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding TrendUp}" Value="False">
              <Setter TargetName="Trend" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Grid>
      <!-- ── Today / Profit: by payment, by cashier, products ── -->
      <Grid Visibility="{Binding Section, Converter={StaticResource EqualsVisible}, ConverterParameter=Today|Profit}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="300" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,16,0">
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="By payment" Style="{StaticResource Text.Overline}" Margin="0,0,0,8" />
              <ItemsControl ItemsSource="{Binding Summary.ByPayment}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type data:AmountRow}">
                    <Grid Margin="0,4">
                      <TextBlock><Run Text="{Binding Label, Mode=OneWay}" FontWeight="Medium" /> <Run Text="{Binding Bills, Mode=OneWay}" Foreground="{DynamicResource Brush.TextTertiary}" /></TextBlock>
                      <TextBlock Text="{Binding Amount, Converter={StaticResource Money}}" Style="{StaticResource Text.MoneyStrong}" HorizontalAlignment="Right" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="By cashier" Style="{StaticResource Text.Overline}" Margin="0,0,0,8" />
              <ItemsControl ItemsSource="{Binding Summary.ByCashier}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type data:AmountRow}">
                    <Grid Margin="0,4">
                      <TextBlock><Run Text="{Binding Label, Mode=OneWay}" FontWeight="Medium" /> <Run Text="{Binding Bills, Mode=OneWay}" Foreground="{DynamicResource Brush.TextTertiary}" /></TextBlock>
                      <TextBlock Text="{Binding Amount, Converter={StaticResource Money}}" Style="{StaticResource Text.MoneyStrong}" HorizontalAlignment="Right" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
          <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource TableHeader}" CornerRadius="14,14,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition /><ColumnDefinition Width="70" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /><ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Product" Style="{StaticResource Th}" />
                <TextBlock Grid.Column="1" Text="Units" Style="{StaticResource ThR}" />
                <TextBlock Grid.Column="2" Text="Sales" Style="{StaticResource ThR}" />
                <TextBlock Grid.Column="3" Text="Profit" Style="{StaticResource ThR}" Visibility="{Binding IsOwner, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Grid.Column="4" Text="Margin" Style="{StaticResource ThR}" Visibility="{Binding IsOwner, Converter={StaticResource BoolToVisibility}}" />
              </Grid>
            </Border>
            <Grid>
              <ListBox Style="{StaticResource Table}" ItemsSource="{Binding ProductRows}" Focusable="False" SelectedItem="{Binding OpenProductRow}"
                       ToolTip="Click a product to see its sales graph">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type data:ProductSalesRow}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition Width="70" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /><ColumnDefinition Width="80" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Units}" Style="{StaticResource Text.Money}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Sales, Converter={StaticResource Money}}" Style="{StaticResource Text.MoneyStrong}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding Profit, Converter={StaticResource Money}}" Style="{StaticResource Text.Money}" VerticalAlignment="Center"
                                 Visibility="{Binding DataContext.IsOwner, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                      <TextBlock Grid.Column="4" Style="{StaticResource Text.Money}" VerticalAlignment="Center"
                                 Visibility="{Binding DataContext.IsOwner, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                        <Run Text="{Binding MarginPercent, Mode=OneWay}" /><Run Text="%" />
                      </TextBlock>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <controls:StateView Icon="&#xE9D2;" Title="No sales in this period" Message="Sales appear here as soon as bills are saved."
                                  Visibility="{Binding ProductRows.Count, Converter={StaticResource PositiveToVisible}, ConverterParameter=invert}" />
            </Grid>
          </DockPanel>
        </Border>
      </Grid>

      <!-- ── Sales: graph on top, the same numbers as a table below ── -->
      <Grid Visibility="{Binding Section, Converter={StaticResource EqualsVisible}, ConverterParameter=Sales}">
        <Grid.RowDefinitions>
          <RowDefinition Height="3*" MinHeight="240" />
          <RowDefinition Height="2*" MinHeight="160" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,16,20,12">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding ChartTitle}" Style="{StaticResource Text.Emphasis}" Margin="0,0,0,4" />
            <TextBlock DockPanel.Dock="Top" Text="Point at a bar to see the exact amount." Style="{StaticResource Text.Caption}" />
            <controls:BarChart Bars="{Binding Chart}" Margin="0,6,0,0" />
          </DockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
          <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource TableHeader}" CornerRadius="14,14,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition /><ColumnDefinition Width="80" /><ColumnDefinition Width="80" /><ColumnDefinition Width="150" /><ColumnDefinition Width="140" /><ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="When" Style="{StaticResource Th}" />
                <TextBlock Grid.Column="1" Text="Bills" Style="{StaticResource ThR}" />
                <TextBlock Grid.Column="2" Text="Units" Style="{StaticResource ThR}" />
                <TextBlock Grid.Column="3" Text="Sales" Style="{StaticResource ThR}" />
                <TextBlock Grid.Column="4" Text="Discounts" Style="{StaticResource ThR}" />
                <TextBlock Grid.Column="5" Text="Profit" Style="{StaticResource ThR}" Visibility="{Binding IsOwner, Converter={StaticResource BoolToVisibility}}" />
              </Grid>
            </Border>
            <Grid>
              <ListBox Style="{StaticResource Table}" ItemsSource="{Binding Days}" Focusable="False">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type data:PeriodRow}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition Width="80" /><ColumnDefinition Width="80" /><ColumnDefinition Width="150" /><ColumnDefinition Width="140" /><ColumnDefinition Width="140" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding LongLabel}" FontWeight="Medium" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Bills}" Style="{StaticResource Text.Money}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Units}" Style="{StaticResource Text.Money}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding Sales, Converter={StaticResource Money}}" Style="{StaticResource Text.MoneyStrong}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Text="{Binding Discounts, Converter={StaticResource Money}}" Style="{StaticResource Text.Money}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="5" Text="{Binding Profit, Converter={StaticResource Money}}" Style="{StaticResource Text.Money}" VerticalAlignment="Center"
                                 Visibility="{Binding DataContext.IsOwner, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <controls:StateView Icon="&#xE9D2;" Title="No sales in this period" Message="Try another day, or press the arrow to go back."
                                  Visibility="{Binding Days.Count, Converter={StaticResource PositiveToVisible}, ConverterParameter=invert}" />
            </Grid>
          </DockPanel>
        </Border>
      </Grid>

      <!-- ── Stock ── -->
      <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding Section, Converter={StaticResource EqualsVisible}, ConverterParameter=Stock}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Style="{StaticResource TableHeader}" CornerRadius="14,14,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition /><ColumnDefinition Width="160" /><ColumnDefinition Width="70" /><ColumnDefinition Width="0" /><ColumnDefinition Width="140" /><ColumnDefinition Width="140" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Product" Style="{StaticResource Th}" />
              <TextBlock Grid.Column="1" Text="Category" Style="{StaticResource Th}" />
              <TextBlock Grid.Column="2" Text="Qty" Style="{StaticResource ThR}" />
              
              <TextBlock Grid.Column="4" Text="At cost" Style="{StaticResource ThR}" Visibility="{Binding IsOwner, Converter={StaticResource BoolToVisibility}}" />
              <TextBlock Grid.Column="5" Text="At price" Style="{StaticResource ThR}" />
            </Grid>
          </Border>
          <ListBox Style="{StaticResource Table}" ItemsSource="{Binding StockRows}" Focusable="False">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type data:StockRow}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition Width="160" /><ColumnDefinition Width="70" /><ColumnDefinition Width="0" /><ColumnDefinition Width="140" /><ColumnDefinition Width="140" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Category}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Qty}" Style="{StaticResource Text.MoneyStrong}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding ExpiredQty}" Style="{StaticResource Text.Money}" Foreground="{DynamicResource Brush.Danger}" VerticalAlignment="Center"
                             Visibility="{Binding ExpiredQty, Converter={StaticResource PositiveToVisible}}" />
                  <TextBlock Grid.Column="4" Text="{Binding ValueAtCost, Converter={StaticResource Money}}" Style="{StaticResource Text.Money}" VerticalAlignment="Center"
                             Visibility="{Binding DataContext.IsOwner, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                  <TextBlock Grid.Column="5" Text="{Binding ValueAtPrice, Converter={StaticResource Money}}" Style="{StaticResource Text.Money}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- ── Low stock & expiry ── -->
      <Grid Visibility="{Binding Section, Converter={StaticResource EqualsVisible}, ConverterParameter=LowStockExpiry}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,8,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Low and out of stock" Style="{StaticResource Text.Overline}" Margin="16,14,16,6" />
            <Grid>
              <ListBox Style="{StaticResource Table}" ItemsSource="{Binding LowRows}" Focusable="False">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type data:ProductRow}">
                    <Grid>
                      <TextBlock Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,110,0" TextTrimming="CharacterEllipsis" />
                      <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Text.Secondary}">
                        <Run Text="{Binding StockQty, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Warning}" /> <Run Text="left · reorder at" /> <Run Text="{Binding ReorderLevel, Mode=OneWay}" />
                      </TextBlock>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <controls:StateView Icon="&#xE73E;" Title="Nothing is low" Message="Every product is above its reorder level."
                                  Visibility="{Binding LowRows.Count, Converter={StaticResource PositiveToVisible}, ConverterParameter=invert}" />
            </Grid>
          </DockPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" Margin="8,0,0,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Expiring soon (sell first) and expired (take off the shelf)" Style="{StaticResource Text.Overline}" Margin="16,14,16,6" TextWrapping="Wrap" />
            <Grid>
              <ListBox Style="{StaticResource Table}" ItemsSource="{Binding ExpiryRows}" Focusable="False">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type data:ExpiryRow}">
                    <Grid>
                      <StackPanel Margin="0,0,150,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProductName}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource Text.Caption}">
                          <Run Text="{Binding QtyOnHand, Mode=OneWay}" /> <Run Text="units · batch" /> <Run Text="{Binding BatchNo, Mode=OneWay, TargetNullValue='-'}" />
                        </TextBlock>
                      </StackPanel>
                      <Border x:Name="Badge" Style="{StaticResource Badge.Warning}" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock>
                          <Run x:Name="Word" Text="Expires" /> <Run Text="{Binding ExpiryDate, Mode=OneWay, Converter={StaticResource Date}}" />
                        </TextBlock>
                      </Border>
                    </Grid>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsExpired}" Value="True">
                        <Setter TargetName="Badge" Property="Style" Value="{StaticResource Badge.Danger}" />
                        <Setter TargetName="Word" Property="Text" Value="Expired" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <controls:StateView Icon="&#xE73E;" Title="Nothing expires soon" Message="Add expiry dates in Stock in to see them here."
                                  Visibility="{Binding ExpiryRows.Count, Converter={StaticResource PositiveToVisible}, ConverterParameter=invert}" />
            </Grid>
          </DockPanel>
        </Border>
      </Grid>

      <!-- ── Discounts & price changes / activity log ── -->
      <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding Section, Converter={StaticResource EqualsVisible}, ConverterParameter=Changes|Activity}">
        <DockPanel>
          <TextBox DockPanel.Dock="Top" Margin="12,12,12,4" ds:Ds.Icon="&#xE721;" ds:Ds.Placeholder="Search the log"
                   Text="{Binding BillSearch, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                   Visibility="{Binding Section, Converter={StaticResource EqualsVisible}, ConverterParameter=Activity}" />
          <Border DockPanel.Dock="Top" Style="{StaticResource TableHeader}" CornerRadius="14,14,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" /><ColumnDefinition Width="170" /><ColumnDefinition Width="140" /><ColumnDefinition />
              </Grid.ColumnDefinitions>
              <TextBlock Text="When" Style="{StaticResource Th}" />
              <TextBlock Grid.Column="1" Text="What" Style="{StaticResource Th}" />
              <TextBlock Grid.Column="2" Text="Who" Style="{StaticResource Th}" />
              <TextBlock Grid.Column="3" Text="Details (old → new)" Style="{StaticResource Th}" />
            </Grid>
          </Border>
          <Grid>
            <ListBox Style="{StaticResource Table}" ItemsSource="{Binding Changes}" Focusable="False">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type data:ChangeLogRow}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="120" /><ColumnDefinition Width="170" /><ColumnDefinition Width="140" /><ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding AtLocal, Converter={StaticResource DateTime}}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Action}" FontWeight="Medium" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding User}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding Summary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <controls:StateView Icon="&#xE73E;" Title="No changes in this period" Message="Price changes, discounts and voids are listed here with who did them."
                                Visibility="{Binding Changes.Count, Converter={StaticResource PositiveToVisible}, ConverterParameter=invert}" />
          </Grid>
        </DockPanel>
      </Border>

      <!-- ── Bills ── -->
      <Grid Visibility="{Binding Section, Converter={StaticResource EqualsVisible}, ConverterParameter=Bills}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>
        <DockPanel Margin="0,0,16,0">
          <TextBox DockPanel.Dock="Top" Style="{StaticResource Input.Search}" ds:Ds.Icon="&#xE721;" ds:Ds.Placeholder="Bill number (finds it on any date)"
                   Text="{Binding BillSearch, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
          <Border Style="{StaticResource Card}" Padding="0">
            <Grid>
              <ListBox Style="{StaticResource Table}" ItemsSource="{Binding Bills}" SelectedItem="{Binding SelectedBill}">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type data:BillRow}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" /><ColumnDefinition Width="120" /><ColumnDefinition /><ColumnDefinition Width="110" /><ColumnDefinition Width="120" />
                      </Grid.ColumnDefinitions>
                      <TextBlock FontWeight="SemiBold" VerticalAlignment="Center"><Run Text="#" /><Run Text="{Binding Number, Mode=OneWay}" /></TextBlock>
                      <TextBlock Grid.Column="1" Text="{Binding CreatedAtLocal, Converter={StaticResource DateTime}}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource Text.Secondary}">
                        <Run Text="{Binding Cashier, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding Methods, Mode=OneWay}" />
                      </TextBlock>
                      <Border Grid.Column="3" Style="{StaticResource Badge.Danger}" Visibility="{Binding Status, Converter={StaticResource EqualsVisible}, ConverterParameter=Voided}">
                        <TextBlock Text="Voided" />
                      </Border>
                      <TextBlock Grid.Column="4" Text="{Binding Total, Converter={StaticResource Money}}" Style="{StaticResource Text.MoneyStrong}" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <controls:StateView Icon="&#xE8A5;" Title="No bills" Message="No bills in these dates. Type a bill number to find any bill."
                                  Visibility="{Binding Bills.Count, Converter={StaticResource PositiveToVisible}, ConverterParameter=invert}" />
            </Grid>
          </Border>
        </DockPanel>

        <!-- Bill detail -->
        <Border Grid.Column="1" Style="{StaticResource Card}">
          <Grid>
            <DockPanel Visibility="{Binding Bill, Converter={StaticResource NullToCollapsed}}">
              <StackPanel DockPanel.Dock="Top">
                <Grid>
                  <TextBlock Style="{StaticResource Text.Title}"><Run Text="Bill #" /><Run Text="{Binding Bill.Number, Mode=OneWay}" /></TextBlock>
                  <Border Style="{StaticResource Badge.Danger}" HorizontalAlignment="Right" Visibility="{Binding Bill.Status, Converter={StaticResource EqualsVisible}, ConverterParameter=Voided}">
                    <TextBlock Text="Voided" />
                  </Border>
                </Grid>
                <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,4,0,12">
                  <Run Text="{Binding Bill.CreatedAtLocal, Mode=OneWay, Converter={StaticResource DateTime}}" /> <Run Text="· by" /> <Run Text="{Binding Bill.Cashier, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding Bill.VoidReason, StringFormat='Void reason: {0}'}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding Bill.VoidReason, Converter={StaticResource NullToCollapsed}}" />
              </StackPanel>
              <StackPanel DockPanel.Dock="Bottom">
                <Border Style="{StaticResource Divider}" Margin="0,8,0,10" />
                <Grid Margin="0,2"><TextBlock Text="Subtotal" Style="{StaticResource Text.Secondary}" /><TextBlock Text="{Binding Bill.Subtotal, Converter={StaticResource Money}}" Style="{StaticResource Text.Money}" HorizontalAlignment="Right" /></Grid>
                <Grid Margin="0,2"><TextBlock Text="Discounts" Style="{StaticResource Text.Secondary}" /><TextBlock Text="{Binding Bill.DiscountTotal, Converter={StaticResource Money}}" Style="{StaticResource Text.Money}" HorizontalAlignment="Right" /></Grid>
                <Grid Margin="0,6,0,2"><TextBlock Text="Total" FontWeight="SemiBold" FontSize="16" /><TextBlock Text="{Binding Bill.Total, Converter={StaticResource MoneyWithSymbol}}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" /></Grid>
                <ItemsControl ItemsSource="{Binding Bill.Payments}" Margin="0,6,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type data:PaymentView}">
                      <Grid Margin="0,2">
                        <TextBlock Style="{StaticResource Text.Secondary}"><Run Text="{Binding Method, Mode=OneWay}" /> <Run Text="{Binding Reference, Mode=OneWay}" /></TextBlock>
                        <TextBlock Text="{Binding Tendered, Converter={StaticResource Money}}" Style="{StaticResource Text.Money}" HorizontalAlignment="Right" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Margin="0,2" Visibility="{Binding Bill.Change, Converter={StaticResource PositiveToVisible}}">
                  <TextBlock Text="Change" Style="{StaticResource Text.Secondary}" />
                  <TextBlock Text="{Binding Bill.Change, Converter={StaticResource Money}}" Style="{StaticResource Text.Money}" HorizontalAlignment="Right" />
                </Grid>
                <UniformGrid Columns="2" Margin="0,14,0,0">
                  <Button Content="Reprint" ds:Ds.Icon="&#xE749;" Command="{Binding ReprintCommand}" Margin="0,0,4,0" />
                  <Button Style="{StaticResource Button.Danger}" Content="Void bill" Command="{Binding VoidCommand}" Margin="4,0,0,0"
                          IsEnabled="{Binding Bill.Status, Converter={StaticResource Equals}, ConverterParameter=Completed}" />
                </UniformGrid>
              </StackPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Bill.Lines}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type data:SaleLineView}">
                      <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="{Binding Name}" FontWeight="Medium" TextWrapping="Wrap" />
                        <Grid>
                          <TextBlock Style="{StaticResource Text.Secondary}">
                            <Run Text="{Binding Qty, Mode=OneWay}" /> <Run Text="×" /> <Run Text="{Binding UnitPrice, Mode=OneWay, Converter={StaticResource Money}}" />
                          </TextBlock>
                          <TextBlock Text="{Binding Gross, Converter={StaticResource Money}}" Style="{StaticResource Text.Money}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Warning}" Visibility="{Binding PriceChanged, Converter={StaticResource BoolToVisibility}}">
                          <Run Text="Price changed from" /> <Run Text="{Binding ListPrice, Mode=OneWay, Converter={StaticResource Money}}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Success}" Visibility="{Binding DiscountAmount, Converter={StaticResource PositiveToVisible}}">
                          <Run Text="Discount −" /><Run Text="{Binding DiscountAmount, Mode=OneWay, Converter={StaticResource Money}}" />
                        </TextBlock>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
            <controls:StateView Icon="&#xE8A5;" Title="Choose a bill" Message="Its items, payments and actions show here."
                                Visibility="{Binding Bill, Converter={StaticResource NullToVisible}}" />
          </Grid>
        </Border>
      </Grid>

      <controls:StateView Tone="Loading" Title="Working out the report…" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
      <controls:StateView Tone="Error" Icon="&#xE783;" Title="The report could not load" Message="{Binding LoadError}" Visibility="{Binding LoadError, Converter={StaticResource NullToCollapsed}}">
        <controls:StateView.Action>
          <Button Content="Try again" Command="{Binding RefreshCommand}" />
        </controls:StateView.Action>
      </controls:StateView>
    </Grid>
  </DockPanel>
</UserControl>
