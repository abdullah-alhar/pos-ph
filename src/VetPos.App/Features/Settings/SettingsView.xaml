<UserControl x:Class="VetPos.App.Features.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ds="clr-namespace:VetPos.App.DesignSystem"
             xmlns:data="clr-namespace:VetPos.Data.Services;assembly=VetPos.Data"
             xmlns:local="clr-namespace:VetPos.App.Features.Settings"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance local:SettingsViewModel}">
  <UserControl.Resources>
    <Style x:Key="L" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
      <Setter Property="Margin" Value="2,16,0,6" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
      <Setter Property="Margin" Value="26,2,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="MaxWidth" Value="720" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Padding" Value="24" />
    </Style>
  </UserControl.Resources>

  <DockPanel Margin="{StaticResource Pad.Page}">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <TextBlock Text="Settings" Style="{StaticResource Text.PageTitle}" />
      <TextBlock Text="Only the owner can change these. Every change is written to the activity log." Style="{StaticResource Text.Secondary}" FontSize="14" Margin="0,4,0,0" />
    </StackPanel>
    <!-- Section menu on the left -->
    <StackPanel DockPanel.Dock="Left" Width="220" Margin="0,0,24,0">
      <RadioButton Style="{StaticResource SideTab}" ds:Ds.Icon="&#xE719;" Content="Shop &amp; logo" IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Shop}" />
      <RadioButton Style="{StaticResource SideTab}" ds:Ds.Icon="&#xE7BF;" Content="Billing" IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Billing}" />
      <RadioButton Style="{StaticResource SideTab}" ds:Ds.Icon="&#xE749;" Content="Receipt printer" IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Printer}" />
      <RadioButton Style="{StaticResource SideTab}" ds:Ds.Icon="&#xE716;" Content="Users" IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Users}" />
      <RadioButton Style="{StaticResource SideTab}" ds:Ds.Icon="&#xE8F1;" Content="Backups" IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Backups}" />
      <RadioButton Style="{StaticResource SideTab}" IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=AI}">
        <StackPanel Orientation="Horizontal">
          <Path Style="{StaticResource AiSpark}" Width="15" Height="15" Margin="-30,0,15,0" />
          <TextBlock Text="AI assistant" />
        </StackPanel>
      </RadioButton>
      <RadioButton Style="{StaticResource SideTab}" ds:Ds.Icon="&#xE790;" Content="Appearance" IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Appearance}" />
      <RadioButton Style="{StaticResource SideTab}" ds:Ds.Icon="&#xE946;" Content="About, updates &amp; uninstall" IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=About}" />
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
      <Grid ds:Ds.EnterNext="True">
        <!-- Shop -->
        <Border Style="{StaticResource SectionCard}" Visibility="{Binding Section, Converter={StaticResource EqualsVisible}, ConverterParameter=Shop}">
          <StackPanel>
            <TextBlock Text="Shop details" Style="{StaticResource Text.Title}" />
            <TextBlock Text="Printed on receipts and reports. The receipt layout is in the Bill editor." Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
            <TextBlock Text="Shop name" Style="{StaticResource L}" />
            <TextBox Text="{Binding ShopName, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Address" Style="{StaticResource L}" />
            <TextBox Text="{Binding ShopAddress, UpdateSourceTrigger=PropertyChanged}" />
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Phone" Style="{StaticResource L}" />
                <TextBox Text="{Binding ShopPhone, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Margin="8,0,0,0">
                <TextBlock Text="Email" Style="{StaticResource L}" />
                <TextBox Text="{Binding ShopEmail, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </UniformGrid>
            <TextBlock Text="Logo (shows in the app and prints on receipts in black and white)" Style="{StaticResource L}" />
            <StackPanel Orientation="Horizontal">
              <Border Width="88" Height="88" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Brush.Line}" Background="White" Margin="0,0,12,0">
                <Grid>
                  <Image Source="{Binding LogoImage}" Stretch="Uniform" Margin="6" />
                  <TextBlock Text="No logo" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Visibility="{Binding LogoImage, Converter={StaticResource NullToVisible}}" />
                </Grid>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <Button Content="Choose picture…" Command="{Binding ChooseLogoCommand}" />
                <Button Style="{StaticResource Button.Subtle}" Content="Remove logo" Command="{Binding RemoveLogoCommand}" Margin="0,6,0,0"
                        Visibility="{Binding LogoImage, Converter={StaticResource NullToCollapsed}}" />
              </StackPanel>
            </StackPanel>
            <TextBlock Text="Currency: LKR (Rs, with cents)" Style="{StaticResource Text.Secondary}" Margin="2,16,0,0" />
            <Button Style="{StaticResource Button.Primary}" Content="Save" HorizontalAlignment="Left" Margin="0,24,0,0" Command="{Binding SaveShopCommand}" />
          </StackPanel>
        </Border>

        <!-- Billing -->
        <Border Style="{StaticResource SectionCard}" Visibility="{Binding Section, Converter={StaticResource EqualsVisible}, ConverterParameter=Billing}">
          <StackPanel>
            <TextBlock Text="Billing" Style="{StaticResource Text.Title}" />
            <CheckBox Content="Allow selling more than the stock shows" IsChecked="{Binding AllowSellAboveStock}" Margin="0,18,0,0" />
            <TextBlock Text="Off (recommended): the cashier sees “Only 3 left” and cannot sell more. On: the sale goes through with a warning and is logged." Style="{StaticResource Hint}" />
            <CheckBox Content="Print the receipt after every sale" IsChecked="{Binding AutoPrint}" Margin="0,16,0,0" />
            <CheckBox Content="Ask before removing an item from the bill" IsChecked="{Binding ConfirmRemoveLine}" Margin="0,16,0,0" />
            <TextBlock Text="Lock the screen after this many idle minutes (0 = never)" Style="{StaticResource L}" />
            <TextBox Style="{StaticResource Input.Number}" Text="{Binding AutoLockMinutes, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" />
            <TextBlock Text="Discounts have no limit and no PIN for now; every price change and discount is saved with who gave it (Reports → Discounts &amp; price changes)."
                       Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="2,18,0,0" />
            <Button Style="{StaticResource Button.Primary}" Content="Save" HorizontalAlignment="Left" Margin="0,24,0,0" Command="{Binding SaveBillingCommand}" />
          </StackPanel>
        </Border>

        <!-- Printer -->
        <Border Style="{StaticResource SectionCard}" Visibility="{Binding Section, Converter={StaticResource EqualsVisible}, ConverterParameter=Printer}">
          <StackPanel>
            <TextBlock Text="Receipt printer" Style="{StaticResource Text.Title}" />
            <TextBlock Text="80 mm thermal printers (ESC/POS) work through their Windows driver or the network." Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
            <TextBlock Text="How is it connected?" Style="{StaticResource L}" />
            <ComboBox ItemsSource="{Binding PrinterModes}" SelectedItem="{Binding PrinterMode}" MinHeight="40" Width="260" HorizontalAlignment="Left" />
            <TextBlock Text="None = do not print · Windows = USB printer with its driver · Network = printer with an IP address · File = save to a text file (testing)"
                       Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="2,6,0,0" />
            <StackPanel Visibility="{Binding PrinterMode, Converter={StaticResource EqualsVisible}, ConverterParameter=Windows}">
              <TextBlock Text="Printer" Style="{StaticResource L}" />
              <ComboBox ItemsSource="{Binding InstalledPrinters}" SelectedItem="{Binding WindowsPrinterName}" MinHeight="40" />
            </StackPanel>
            <StackPanel Visibility="{Binding PrinterMode, Converter={StaticResource EqualsVisible}, ConverterParameter=Network}" Orientation="Horizontal">
              <StackPanel Width="260">
                <TextBlock Text="IP address" Style="{StaticResource L}" />
                <TextBox Text="{Binding NetworkHost, UpdateSourceTrigger=PropertyChanged}" ds:Ds.Placeholder="192.168.1.50" />
              </StackPanel>
              <StackPanel Width="120" Margin="12,0,0,0">
                <TextBlock Text="Port" Style="{StaticResource L}" />
                <TextBox Style="{StaticResource Input.Number}" Text="{Binding NetworkPort, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </StackPanel>
            <CheckBox Content="58 mm paper (32 characters a line)" IsChecked="{Binding NarrowPaper}" Margin="0,18,0,0" />
            <CheckBox Content="Cut the paper after each receipt" IsChecked="{Binding AutoCut}" Margin="0,12,0,0" />
            <CheckBox Content="Open the cash drawer after a cash sale" IsChecked="{Binding OpenDrawer}" Margin="0,12,0,0" />
            <TextBlock Text="Copies of each receipt (1–3)" Style="{StaticResource L}" />
            <TextBox Style="{StaticResource Input.Number}" Text="{Binding Copies, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
              <Button Style="{StaticResource Button.Primary}" Content="Save" Command="{Binding SavePrinterCommand}" />
              <Button Content="Test print" ds:Ds.Icon="&#xE749;" Command="{Binding TestPrinterCommand}" Margin="8,0,0,0" />
              <Button Content="Open cash drawer" Command="{Binding OpenDrawerNowCommand}" Margin="8,0,0,0" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Users -->
        <Border Style="{StaticResource SectionCard}" Visibility="{Binding Section, Converter={StaticResource EqualsVisible}, ConverterParameter=Users}">
          <StackPanel>
            <Grid>
              <TextBlock Text="Users" Style="{StaticResource Text.Title}" />
              <Button Style="{StaticResource Button.Primary}" Content="Add user" HorizontalAlignment="Right" Command="{Binding EditUserCommand}" />
            </Grid>
            <TextBlock Text="Everyone signs in with their own username and PIN, so every bill and change shows who did it." Style="{StaticResource Text.Secondary}" Margin="0,4,0,12" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Users}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type data:UserInfo}">
                  <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Line}" Padding="0,12">
                    <Grid>
                      <StackPanel>
                        <TextBlock FontWeight="Medium"><Run Text="{Binding FullName, Mode=OneWay}" /> <Run Text="@" Foreground="{DynamicResource Brush.TextTertiary}" /><Run Text="{Binding Username, Mode=OneWay}" Foreground="{DynamicResource Brush.TextTertiary}" /></TextBlock>
                        <TextBlock Style="{StaticResource Text.Caption}">
                          <Run Text="{Binding Role, Mode=OneWay}" /> <Run Text="· last sign-in" /> <Run Text="{Binding LastLoginAt, Mode=OneWay, Converter={StaticResource DateTime}}" />
                        </TextBlock>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Style="{StaticResource Badge}" Margin="0,0,10,0" Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVisibility}}"><TextBlock Text="Switched off" /></Border>
                        <Button Style="{StaticResource Button.Small}" Content="Change" Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Backups -->
        <Border Style="{StaticResource SectionCard}" Visibility="{Binding Section, Converter={StaticResource EqualsVisible}, ConverterParameter=Backups}">
          <StackPanel>
            <Grid>
              <TextBlock Text="Backups" Style="{StaticResource Text.Title}" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Open folder" Command="{Binding OpenBackupFolderCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource Button.Primary}" Content="Backup now" Command="{Binding BackupNowCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
              </StackPanel>
            </Grid>
            <CheckBox Content="Make a backup every day automatically" IsChecked="{Binding DailyBackup}" Margin="0,16,0,0" />
            <TextBlock Text="Each backup is checked after it is made. The app can stay open while it runs." Style="{StaticResource Hint}" />
            <TextBlock Text="How many backups to keep" Style="{StaticResource L}" />
            <TextBox Style="{StaticResource Input.Number}" Text="{Binding KeepBackups, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" />
            <TextBlock Text="Also copy each backup to (USB drive or another disk, optional)" Style="{StaticResource L}" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Choose…" Command="{Binding ChooseExtraFolderCommand}" Margin="8,0,0,0" />
              <TextBox Text="{Binding ExtraFolder, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <Button Content="Save backup settings" HorizontalAlignment="Left" Margin="0,16,0,0" Command="{Binding SaveBackupSettingsCommand}" />

            <TextBlock Text="Backups on this PC" Style="{StaticResource Text.Overline}" Margin="0,28,0,8" />
            <ItemsControl ItemsSource="{Binding BackupFiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type data:BackupFile}">
                  <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Line}" Padding="0,10">
                    <Grid>
                      <StackPanel>
                        <TextBlock Text="{Binding CreatedLocal, Converter={StaticResource DateTime}}" FontWeight="Medium" />
                        <TextBlock Style="{StaticResource Text.Caption}"><Run Text="{Binding Kind, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding FileName, Mode=OneWay}" /></TextBlock>
                      </StackPanel>
                      <Button Style="{StaticResource Button.Small}" Content="Restore" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource Button.Subtle}" Content="Restore from another file…" HorizontalAlignment="Left" Margin="0,8,0,0"
                    Command="{Binding RestoreCommand}" CommandParameter="{x:Null}" />
          </StackPanel>
        </Border>

        <!-- AI -->
        <Border Style="{StaticResource SectionCard}" Visibility="{Binding Section, Converter={StaticResource EqualsVisible}, ConverterParameter=AI}">
          <StackPanel>
            <TextBlock Text="AI assistant" Style="{StaticResource Text.Title}" />
            <TextBlock Text="The assistant answers questions about sales, stock and profit from the shop's own data. It only reads; it never changes anything. Billing never depends on it."
                       Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <CheckBox Content="Switch the assistant on" IsChecked="{Binding AiEnabled}" Margin="0,18,0,0" />
            <TextBlock Text="AI service" Style="{StaticResource L}" />
            <ComboBox ItemsSource="{Binding ProviderOptions}" SelectedItem="{Binding AiProvider}" DisplayMemberPath="Name" MinHeight="40" Width="340" HorizontalAlignment="Left" />
            <Border CornerRadius="10" Background="{DynamicResource Brush.AccentSoft}" Padding="16,12" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentText}">
                  <Run Text="How to get the key" /> <Run Text="·" /> <Run Text="{Binding AiProvider.Free, Mode=OneWay}" FontWeight="Normal" />
                </TextBlock>
                <ItemsControl ItemsSource="{Binding AiProvider.Steps}" Margin="0,8,0,0" AlternationCount="10">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock TextWrapping="Wrap" Margin="0,2">
                        <Run Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Mode=OneWay, Converter={StaticResource StepNumber}}" FontWeight="SemiBold" />
                        <Run Text="{Binding Mode=OneWay}" />
                      </TextBlock>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource Button.Small}" HorizontalAlignment="Left" Margin="0,10,0,0" ds:Ds.Icon="&#xE8A7;" Command="{Binding OpenKeyPageCommand}"
                        Visibility="{Binding AiProvider.KeyUrl, Converter={StaticResource NullToCollapsed}}">
                  <TextBlock><Run Text="Open" /> <Run Text="{Binding AiProvider.KeyUrl, Mode=OneWay}" /></TextBlock>
                </Button>
              </StackPanel>
            </Border>
            <StackPanel Visibility="{Binding AiProvider.Id, Converter={StaticResource EqualsVisible}, ConverterParameter=custom}">
              <TextBlock Text="Service address (ends in /v1)" Style="{StaticResource L}" />
              <TextBox Text="{Binding AiCustomUrl, UpdateSourceTrigger=PropertyChanged}" ds:Ds.Placeholder="https://…/v1" />
            </StackPanel>
            <TextBlock Text="Model (empty = the service's default)" Style="{StaticResource L}" />
            <TextBox Text="{Binding AiModel, UpdateSourceTrigger=PropertyChanged}" ds:Ds.Placeholder="{Binding AiProvider.DefaultModel}" Width="340" HorizontalAlignment="Left" />
            <TextBlock Text="API key (encrypted on this PC with Windows; never shown again)" Style="{StaticResource L}" />
            <PasswordBox x:Name="KeyBox" Style="{StaticResource PinBox}" MaxLength="400" FontSize="14" Width="340" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding AiKeyHint}" Style="{StaticResource Text.Caption}" Margin="2,6,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
              <Button Style="{StaticResource Button.Primary}" Content="Save" Command="{Binding SaveAiCommand}" CommandParameter="{Binding ElementName=KeyBox}" />
              <Button Content="Test the connection" Command="{Binding TestAiCommand}" Margin="8,0,0,0" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Appearance -->
        <Border Style="{StaticResource SectionCard}" Visibility="{Binding Section, Converter={StaticResource EqualsVisible}, ConverterParameter=Appearance}">
          <StackPanel>
            <TextBlock Text="Appearance" Style="{StaticResource Text.Title}" />
            <TextBlock Text="Colour" Style="{StaticResource L}" />
            <TextBlock Text="Changes the menu, buttons, highlights and the Pay button everywhere, straight away." Style="{StaticResource Text.Caption}" Margin="2,0,0,10" />
            <ListBox ItemsSource="{Binding Accents}" SelectedValuePath="Name" SelectedValue="{Binding AccentChoice}" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Left">
              <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel MaxWidth="620" /></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                  <Setter Property="Cursor" Value="Hand" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Width="82" Margin="0,0,8,8" Padding="6,10,6,8" CornerRadius="12" BorderThickness="2"
                                BorderBrush="Transparent" Background="{DynamicResource Brush.Surface}">
                          <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.LineStrong}" />
                          </Trigger>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <Ellipse Width="34" Height="34" Fill="{Binding Swatch}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,0" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>

        <!-- About -->
        <Border Style="{StaticResource SectionCard}" Visibility="{Binding Section, Converter={StaticResource EqualsVisible}, ConverterParameter=About}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Text.Title}"><Run Text="VetPOS" /> <Run Text="{Binding Version, Mode=OneWay}" /></TextBlock>
              <Border Style="{StaticResource Badge.Accent}" Margin="10,3,0,0" VerticalAlignment="Center"
                      Padding="8,2,8,3" CornerRadius="6">
                <TextBlock Text="Beta 3" FontSize="13" FontWeight="SemiBold" />
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding DataFolder, StringFormat='Data folder: {0}'}" Style="{StaticResource Text.Secondary}" Margin="0,6,0,0" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" />
              <Button Content="Open logs" Command="{Binding OpenLogsCommand}" Margin="8,0,0,0" />
              <Button Content="Save a support file" ds:Ds.Icon="&#xE8A5;" Command="{Binding SaveSupportFileCommand}" Margin="8,0,0,0"
                      ToolTip="Puts a zip with the logs on the Desktop to send to support. No bills or PINs are in it." />
            </StackPanel>
            <TextBlock Text="Updates" Style="{StaticResource Text.Overline}" Margin="0,28,0,0" />
            <TextBlock Text="VetPOS updates itself. It looks for a new version by itself every 2 hours and downloads it quietly. When one is ready you see “Update ready” at the bottom of the menu: restart now, or it installs the next time VetPOS closes."
                       Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,6,0,0" />
            <Button Style="{StaticResource Button.Primary}" Content="Check now" Command="{Binding CheckUpdatesCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" />
            <TextBlock Text="Uninstall" Style="{StaticResource Text.Overline}" Margin="0,28,0,0" />
            <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Removes VetPOS from this PC (also possible from Windows Settings → Apps). The shop's data is kept unless you choose to delete it; a copy is then saved to Documents first." />
            <Button Style="{StaticResource Button.Danger}" Content="Uninstall VetPOS…" HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding UninstallCommand}" />
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</UserControl>
