<UserControl x:Class="VetPos.App.Features.Products.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ds="clr-namespace:VetPos.App.DesignSystem"
             xmlns:controls="clr-namespace:VetPos.App.DesignSystem.Controls"
             xmlns:data="clr-namespace:VetPos.Data.Services;assembly=VetPos.Data"
             xmlns:local="clr-namespace:VetPos.App.Features.Products"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance local:ProductsViewModel}">
  <UserControl.InputBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewProductCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
  </UserControl.InputBindings>
  <Grid Margin="{StaticResource Pad.Page}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <DockPanel>
      <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
        <StackPanel>
          <TextBlock Text="Products" Style="{StaticResource Text.PageTitle}" />
          <TextBlock Text="Each pack size is its own product, e.g. “Whiskas Adult 1.2 kg”." Style="{StaticResource Text.Secondary}" FontSize="14" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Command="{Binding AddWithAiCommand}" Margin="0,0,8,0" ToolTip="Opens the AI chat: describe or paste products in any words, check the card, Confirm">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource AiSpark}" Width="16" Height="16" />
              <TextBlock Text="Add with AI" Margin="8,0,0,0" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource Button.Primary}" Content="Add product" ds:Ds.KeyHint="Ctrl+N" Command="{Binding NewProductCommand}" />
        </StackPanel>
      </Grid>

      <!-- Filters on the left (no tabs across the top) -->
      <StackPanel DockPanel.Dock="Left" Width="200" Margin="0,0,20,0">
        <TextBlock Text="Show" Style="{StaticResource Text.Overline}" Margin="12,0,0,8" />
        <RadioButton Style="{StaticResource SideTab}" ds:Ds.Icon="&#xE8FD;" Content="All products" IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=All}" />
        <RadioButton Style="{StaticResource SideTab}" ds:Ds.Icon="&#xE7BA;" IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=LowStock}">
          <DockPanel Width="130">
            <Border DockPanel.Dock="Right" Style="{StaticResource Badge.Warning}" Visibility="{Binding LowCount, Converter={StaticResource PositiveToVisible}}">
              <TextBlock Text="{Binding LowCount}" />
            </Border>
            <TextBlock Text="Low stock" VerticalAlignment="Center" />
          </DockPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource SideTab}" ds:Ds.Icon="&#xE7E8;" Content="Switched off" IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=Inactive}" />
        <Border Style="{StaticResource Divider}" Margin="8,16" />
        <TextBlock Text="Tools" Style="{StaticResource Text.Overline}" Margin="12,0,0,8" />
        <Button Style="{StaticResource Button.Subtle}" HorizontalContentAlignment="Left" Command="{Binding AddWithAiCommand}" Padding="12,0" MinHeight="40">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource AiSpark}" Width="15" Height="15" />
            <TextBlock Text="Add many with AI" Margin="12,0,0,0" />
          </StackPanel>
        </Button>
      </StackPanel>

      <TextBox DockPanel.Dock="Top" Style="{StaticResource Input.Search}" ds:Ds.Icon="&#xE721;" ds:Ds.Placeholder="Search by name or barcode"
               Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

      <Border Style="{StaticResource Card}" Padding="0">
        <Grid>
          <!-- Products -->
          <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource TableHeader}" CornerRadius="14,14,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="80" />
                  <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Product" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Category" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="Price" VerticalAlignment="Center" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Text="Stock" VerticalAlignment="Center" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="4" Text="Status" VerticalAlignment="Center" Margin="16,0,0,0" />
              </Grid>
            </Border>
            <ListBox Style="{StaticResource Table}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type data:ProductRow}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="150" />
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition Width="80" />
                      <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                      <TextBlock Text="{Binding Barcode}" Style="{StaticResource Text.Caption}" FontFamily="{StaticResource Font.Mono}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Category}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding SellingPrice, Converter={StaticResource Money}}" Style="{StaticResource Text.Money}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding StockQty}" Style="{StaticResource Text.MoneyStrong}" VerticalAlignment="Center" />
                    <WrapPanel Grid.Column="4" Margin="16,0,0,0" VerticalAlignment="Center">
                      <Border Style="{StaticResource Badge}" Visibility="{Binding IsOut, Converter={StaticResource BoolToVisibility}}" Margin="0,0,4,0"><TextBlock Text="Out of stock" /></Border>
                      <Border Style="{StaticResource Badge.Warning}" Margin="0,0,4,0">
                        <Border.Visibility>
                          <MultiBinding Converter="{StaticResource AllTrue}">
                            <Binding Path="IsLowStock" />
                            <Binding Path="IsOut" Converter="{StaticResource Not}" />
                          </MultiBinding>
                        </Border.Visibility>
                        <TextBlock Text="Low stock" />
                      </Border>
                      <Border Style="{StaticResource Badge.Success}">
                        <Border.Visibility>
                          <MultiBinding Converter="{StaticResource AllTrue}">
                            <Binding Path="IsLowStock" Converter="{StaticResource Not}" />
                            <Binding Path="IsOut" Converter="{StaticResource Not}" />
                          </MultiBinding>
                        </Border.Visibility>
                        <TextBlock Text="In stock" />
                      </Border>
                      <Border Style="{StaticResource Badge.Danger}" Margin="0,4,4,0" Visibility="{Binding HasExpired, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Expired stock" />
                      </Border>
                      <Border Style="{StaticResource Badge.Warning}" Margin="0,4,4,0" Visibility="{Binding ExpiresSoon, Converter={StaticResource BoolToVisibility}}"
                              ToolTip="{Binding NextExpiry, Converter={StaticResource Date}}">
                        <TextBlock Text="Expires soon" />
                      </Border>
                    </WrapPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <controls:StateView Tone="Loading" Title="Loading products…" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
          <controls:StateView Icon="&#xE8FD;" Title="Nothing here" Message="No products match. Change the search or the filter, or add a product."
                              Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
          <controls:StateView Tone="Error" Icon="&#xE783;" Title="Products could not be loaded" Message="{Binding LoadError}"
                              Visibility="{Binding LoadError, Converter={StaticResource NullToCollapsed}}" />
        </Grid>
      </Border>
    </DockPanel>

    <!-- ───────── Editor panel ───────── -->
    <Border Grid.Column="1" Width="400" Margin="20,0,0,0" Style="{StaticResource Card}" Padding="0"
            Visibility="{Binding Editor, Converter={StaticResource NullToCollapsed}}">
      <DockPanel DataContext="{Binding Editor}">
        <Grid DockPanel.Dock="Top" Margin="20,18,12,8">
          <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" TextWrapping="Wrap" Margin="0,0,40,0" />
          <Button Style="{StaticResource Button.Icon}" Content="&#xE711;" FontFamily="{StaticResource Font.Icons}" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Command="{Binding DataContext.CloseEditorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTip="Close (Esc)" />
        </Grid>
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Line}" Padding="20,12">
          <StackPanel>
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
            <DockPanel>
              <Button DockPanel.Dock="Left" Style="{StaticResource Button.Danger}" ds:Ds.Icon="&#xE74D;" Content="Remove" Margin="0,0,8,0"
                      ToolTip="Remove this product" Visibility="{Binding Id, Converter={StaticResource NullToCollapsed}}"
                      Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
              <Button Style="{StaticResource Button.Primary}" Content="Save product" ds:Ds.KeyHint="Ctrl+S"
                      Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </DockPanel>
          </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0,20,16">
          <StackPanel ds:Ds.EnterNext="True" ds:Ds.EnterSubmit="{Binding DataContext.SaveConfirmCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <TextBlock Text="Enter moves to the next box · on the last box Enter saves" Style="{StaticResource Text.Caption}" Margin="2,0,0,4" />
            <TextBlock Text="Name (with pack size)" Style="{StaticResource FieldLabel}" Margin="2,8,0,6" />
            <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ds:Ds.Placeholder="e.g. Royal Canin Kitten 2 kg" />
            <TextBlock Text="Barcode" Style="{StaticResource FieldLabel}" Margin="2,14,0,6" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Generate" Margin="8,0,0,0" IsTabStop="False" ToolTip="Make a scannable in-store barcode"
                      Command="{Binding DataContext.GenerateBarcodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
              <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}" ds:Ds.Placeholder="Scan it here, or Generate" />
            </DockPanel>
            <Border Background="White" CornerRadius="8" Padding="10,8" Margin="0,8,0,0" HorizontalAlignment="Left"
                    Visibility="{Binding Barcode, Converter={StaticResource NullToCollapsed}}">
              <ContentControl Content="{Binding Barcode, Converter={StaticResource BarcodePreview}}" Focusable="False" />
            </Border>
            <TextBlock Text="More barcodes (comma between)" Style="{StaticResource FieldLabel}" Margin="2,14,0,6" />
            <TextBox Text="{Binding ExtraBarcodes, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}" />
            <TextBlock Text="Category" Style="{StaticResource FieldLabel}" Margin="2,14,0,6" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="New" Margin="8,0,0,0"
                      Command="{Binding DataContext.AddCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
              <ComboBox ItemsSource="{Binding DataContext.Categories, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        SelectedItem="{Binding Category}" DisplayMemberPath="Name" MinHeight="40" />
            </DockPanel>
            <UniformGrid Columns="2" Margin="0,14,0,0">
              <StackPanel Margin="0,0,6,0">
                <TextBlock Text="Unit" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding DataContext.Units, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Unit}" MinHeight="40" />
              </StackPanel>
              <StackPanel Margin="6,0,0,0">
                <TextBlock Text="Reorder level" Style="{StaticResource FieldLabel}" />
                <TextBox Style="{StaticResource Input.Number}" Text="{Binding ReorderLevel, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </UniformGrid>
            <UniformGrid Columns="2" Margin="0,14,0,0">
              <StackPanel Margin="0,0,6,0">
                <TextBlock Text="Cost price (Rs)" Style="{StaticResource FieldLabel}" />
                <TextBox Style="{StaticResource Input.Number}" Text="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Margin="6,0,0,0">
                <TextBlock Text="Selling price (Rs)" Style="{StaticResource FieldLabel}" />
                <TextBox Style="{StaticResource Input.Number}" Text="{Binding SellingPrice, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </UniformGrid>
            <!-- New product: stock now + expiry date (saved as its first stock) -->
            <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="12" Padding="14,12" Margin="0,16,0,0"
                    Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <TextBlock Text="Stock you have now (optional)" Style="{StaticResource Text.Emphasis}" />
                <UniformGrid Columns="2" Margin="0,8,0,0">
                  <StackPanel Margin="0,0,6,0">
                    <TextBlock Text="How many" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input.Number}" Text="{Binding OpeningQty, UpdateSourceTrigger=PropertyChanged}" ds:Ds.Placeholder="0" />
                  </StackPanel>
                  <StackPanel Margin="6,0,0,0">
                    <TextBlock Text="Expiry date" Style="{StaticResource FieldLabel}" />
                    <DatePicker SelectedDate="{Binding Expiry}" MinHeight="46" SelectedDateFormat="Short" />
                  </StackPanel>
                </UniformGrid>
                <TextBlock Text="Leave the date empty if it does not expire. Later stock gets its own date in Stock in." Style="{StaticResource Text.Caption}"
                           TextWrapping="Wrap" Margin="2,8,0,0" />
              </StackPanel>
            </Border>
            <CheckBox Content="This is a medicine" IsChecked="{Binding IsMedicine}" Margin="2,16,0,0" />
            <Border BorderThickness="1" BorderBrush="{DynamicResource Brush.Line}" CornerRadius="10" Padding="12" Margin="0,10,0,0"
                    Visibility="{Binding IsMedicine, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <TextBlock Text="Generic name (active ingredient)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding GenericName, UpdateSourceTrigger=PropertyChanged}" ds:Ds.Placeholder="e.g. Ivermectin" />
                <UniformGrid Columns="2" Margin="0,12,0,0">
                  <StackPanel Margin="0,0,6,0">
                    <TextBlock Text="Strength" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Strength, UpdateSourceTrigger=PropertyChanged}" ds:Ds.Placeholder="e.g. 1% w/v" />
                  </StackPanel>
                  <StackPanel Margin="6,0,0,0">
                    <TextBlock Text="Form" Style="{StaticResource FieldLabel}" />
                    <ComboBox IsEditable="True" Text="{Binding DosageForm, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{x:Static local:ProductEditor.DosageForms}" MinHeight="40" />
                  </StackPanel>
                </UniformGrid>
                <TextBlock Text="For which animals" Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                <TextBox Text="{Binding Species, UpdateSourceTrigger=PropertyChanged}" ds:Ds.Placeholder="e.g. Dogs, cats · Cattle, goats · Poultry" />
              </StackPanel>
            </Border>
            <CheckBox Content="For sale (switch off to hide it from billing)" IsChecked="{Binding IsActive}" Margin="2,10,0,0" />
            <TextBlock Text="{Binding PriceChoiceText}" Style="{StaticResource Text.Caption}" Margin="2,12,0,0" TextWrapping="Wrap"
                       Visibility="{Binding PriceChoiceText, Converter={StaticResource NullToCollapsed}}" />

            <!-- Batches -->
            <StackPanel Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVisibility}}">
              <TextBlock Style="{StaticResource Text.Overline}" Margin="0,24,0,8">
                <Run Text="Stock on hand:" /> <Run Text="{Binding StockQty, Mode=OneWay}" /> <Run Text="units" />
              </TextBlock>
              <ItemsControl ItemsSource="{Binding Batches}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type local:BatchView}">
                    <Border BorderThickness="1" BorderBrush="{DynamicResource Brush.Line}" CornerRadius="12" Padding="14,12" Margin="0,0,0,8">
                      <StackPanel>
                        <TextBlock FontWeight="SemiBold" FontSize="17">
                          <Run Text="{Binding Row.QtyOnHand, Mode=OneWay}" /> <Run Text="units" />
                        </TextBlock>
                        <WrapPanel Margin="0,6,0,0">
                          <Border ds:Ds.StyleKey="{Binding ExpiryTone}" Margin="0,0,6,4"><TextBlock Text="{Binding ExpiryText}" /></Border>
                          <Border ds:Ds.StyleKey="{Binding Tone}" Margin="0,0,6,4"><TextBlock Text="{Binding Status}" /></Border>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0">
                          <Run Text="{Binding Received, Mode=OneWay}" />
                          <Run Text="· sells at" /> <Run Text="{Binding Row.SellingPrice, Mode=OneWay, Converter={StaticResource Money}}" />
                          <Run Text="· batch" /> <Run Text="{Binding Row.BatchNo, Mode=OneWay, TargetNullValue='-'}" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                          <Button Style="{StaticResource Button.Small}" ds:Ds.Icon="&#xE787;" Content="Change expiry date" Margin="0,0,8,0"
                                  Command="{Binding DataContext.ChangeExpiryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                          <Button Style="{StaticResource Button.Small}" ds:Ds.Icon="&#xE70F;" Content="Change count"
                                  Command="{Binding DataContext.AdjustBatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                  Visibility="{Binding DataContext.IsOwner, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="No stock yet. Add it in Stock in (Ctrl+2)." Style="{StaticResource Text.Secondary}"
                         Visibility="{Binding Batches.Count, Converter={StaticResource PositiveToVisible}, ConverterParameter=invert}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
