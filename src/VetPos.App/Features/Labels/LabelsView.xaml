<UserControl x:Class="VetPos.App.Features.Labels.LabelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ds="clr-namespace:VetPos.App.DesignSystem"
             xmlns:controls="clr-namespace:VetPos.App.DesignSystem.Controls"
             xmlns:data="clr-namespace:VetPos.Data.Services;assembly=VetPos.Data"
             xmlns:local="clr-namespace:VetPos.App.Features.Labels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance local:LabelsViewModel}">
  <UserControl.InputBindings>
    <KeyBinding Gesture="Ctrl+P" Command="{Binding PrintCommand}" />
  </UserControl.InputBindings>
  <DockPanel Margin="{StaticResource Pad.Page}">
    <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock Text="Barcode labels" Style="{StaticResource Text.PageTitle}" />
        <TextBlock Text="Price and barcode stickers for the shelf and the products." Style="{StaticResource Text.Secondary}" FontSize="14" Margin="0,4,0,0" />
      </StackPanel>
      <Button Style="{StaticResource Button.Primary}" Content="Print labels" ds:Ds.KeyHint="Ctrl+P" ds:Ds.Icon="&#xE749;" HorizontalAlignment="Right" VerticalAlignment="Center"
              Command="{Binding PrintCommand}" IsEnabled="{Binding HasItems}" />
    </Grid>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Products to label -->
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12" Panel.ZIndex="5">
          <TextBox x:Name="SearchBox" Style="{StaticResource Input.Search}" ds:Ds.Placeholder="Scan or type a product to add its labels"
                   Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="OnSearchKey" />
          <Popup IsOpen="{Binding ShowSuggestions}" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" VerticalOffset="6"
                 Width="{Binding ActualWidth, ElementName=SearchBox}" AllowsTransparency="True" StaysOpen="True" Focusable="False">
            <Border Style="{StaticResource Sheet.Flat}" Padding="4" MaxHeight="360">
              <ListBox x:Name="SuggestionList" ItemsSource="{Binding Suggestions}" SelectedItem="{Binding Suggestion}" Style="{StaticResource Table}" Focusable="False"
                       PreviewMouseLeftButtonUp="OnSuggestionClick">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type data:ProductRow}">
                    <Grid>
                      <TextBlock Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding SellingPrice, Converter={StaticResource Money}}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Text.Money}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </Popup>
        </Grid>
        <Border Style="{StaticResource Card}" Padding="0">
          <Grid>
            <DockPanel Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
              <Border DockPanel.Dock="Top" Style="{StaticResource TableHeader}" CornerRadius="14,14,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition Width="170" /><ColumnDefinition Width="110" /><ColumnDefinition Width="90" /><ColumnDefinition Width="36" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Product" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="Barcode" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="Price" VerticalAlignment="Center" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="3" Text="Labels" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
              </Border>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:LabelItem}">
                      <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Line}" Padding="16,8">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition Width="170" /><ColumnDefinition Width="110" /><ColumnDefinition Width="90" /><ColumnDefinition Width="36" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="Wrap" />
                          <Grid Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Barcode}" FontFamily="{StaticResource Font.Mono}" Style="{StaticResource Text.Secondary}"
                                       Visibility="{Binding Barcode, Converter={StaticResource NullToCollapsed}}" />
                            <Button Style="{StaticResource Button.Small}" Content="Give barcode" HorizontalAlignment="Left"
                                    Visibility="{Binding Barcode, Converter={StaticResource NullToVisible}}"
                                    Command="{Binding DataContext.GiveBarcodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                          </Grid>
                          <TextBlock Grid.Column="2" Text="{Binding Price, Converter={StaticResource Money}}" Style="{StaticResource Text.Money}" VerticalAlignment="Center" />
                          <TextBox Grid.Column="3" Style="{StaticResource Input.Number}" Text="{Binding Copies, UpdateSourceTrigger=PropertyChanged}" Margin="12,0,0,0" />
                          <Button Grid.Column="4" Style="{StaticResource Button.Icon}" Content="&#xE711;" FontFamily="{StaticResource Font.Icons}" FontSize="12" HorizontalAlignment="Right"
                                  Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Remove" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
            <controls:StateView Icon="&#xE8B3;" Title="No labels yet" Message="Scan or search products above. The number of labels starts at the stock on hand."
                                Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}" />
          </Grid>
        </Border>
      </DockPanel>

      <!-- Layout + preview -->
      <StackPanel Grid.Column="1" Width="360" Margin="20,0,0,0">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Paper" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding Layouts}" SelectedItem="{Binding Layout}" MinHeight="40" />
            <TextBlock Text="On each label" Style="{StaticResource FieldLabel}" Margin="2,16,0,6" />
            <CheckBox Content="Shop name" IsChecked="{Binding ShowShop}" />
            <CheckBox Content="Product name" IsChecked="{Binding ShowName}" Margin="0,8,0,0" />
            <CheckBox Content="Price" IsChecked="{Binding ShowPrice}" Margin="0,8,0,0" />
            <CheckBox Content="Barcode" IsChecked="{Binding ShowBarcode}" Margin="0,8,0,0" />
            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" Margin="2,16,0,0" />
            <Button Style="{StaticResource Button.Subtle}" Content="Clear the list" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding ClearAllCommand}"
                    Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </Border>
        <TextBlock Text="Preview (first page)" Style="{StaticResource Text.Overline}" Margin="0,18,0,8" />
        <Border Background="{DynamicResource Brush.SurfaceSunken}" CornerRadius="14" Padding="12" Height="420">
          <Viewbox Stretch="Uniform">
            <Border Background="White" Effect="{StaticResource Shadow.Card}">
              <ContentControl Content="{Binding Preview}" />
            </Border>
          </Viewbox>
        </Border>
      </StackPanel>
    </Grid>
  </DockPanel>
</UserControl>
