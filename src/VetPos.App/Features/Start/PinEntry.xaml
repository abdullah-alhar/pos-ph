<UserControl x:Class="VetPos.App.Features.Start.PinEntry"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
  <!-- PIN slots + round keypad. The keyboard types into a hidden PasswordBox, so the PIN is never
       kept as a normal string in the window and typing and clicking work together. -->
  <StackPanel HorizontalAlignment="Center">
    <Grid HorizontalAlignment="Center">
      <PasswordBox x:Name="Box" MaxLength="8" Width="1" Height="1" Opacity="0" IsTabStop="True" InputMethod.IsInputMethodEnabled="False"
                   AutomationProperties.Name="PIN" HorizontalAlignment="Left" />
      <StackPanel x:Name="Dots" Orientation="Horizontal" Height="22" HorizontalAlignment="Center" Cursor="IBeam" Background="Transparent" />
    </Grid>
    <TextBlock x:Name="Message" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320"
               Margin="0,12,0,0" MinHeight="20" Foreground="{DynamicResource Brush.TextSecondary}" />
    <UniformGrid x:Name="Keys" Columns="3" HorizontalAlignment="Center" Margin="0,14,0,0" />
  </StackPanel>
</UserControl>
