<UserControl x:Class="VetPos.App.Features.Start.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ds="clr-namespace:VetPos.App.DesignSystem"
             xmlns:local="clr-namespace:VetPos.App.Features.Start">
  <Grid Background="{DynamicResource Brush.Background}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="5*" MinWidth="380" />
      <ColumnDefinition Width="6*" />
    </Grid.ColumnDefinitions>

    <local:BrandPanel Title="Welcome to VetPOS" Subtitle="Two minutes to set up. Everything can be changed later in Settings." />

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40">
        <TextBlock Text="Set up your shop" FontSize="30" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Text.Secondary}" FontSize="15" Margin="0,4,0,0" TextWrapping="Wrap"
                   Text="Press Enter to go to the next box." />

        <!-- 1 Shop -->
        <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
          <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Brush.Accent}">
            <TextBlock Text="1" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="The shop" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="Shop name" Style="{StaticResource FieldLabel}" Margin="2,14,0,6" />
        <TextBox x:Name="Shop" Text="{Binding ShopName, UpdateSourceTrigger=PropertyChanged}" ds:Ds.Placeholder="e.g. Happy Paws Vet Shop" FontSize="16" MinHeight="48" />

        <!-- 2 Owner -->
        <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
          <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Brush.Accent}">
            <TextBlock Text="2" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="The owner's account" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <UniformGrid Columns="2" Margin="0,14,0,0">
          <StackPanel Margin="0,0,8,0">
            <TextBlock Text="Your name" Style="{StaticResource FieldLabel}" Margin="2,0,0,6" />
            <TextBox Text="{Binding OwnerName, UpdateSourceTrigger=PropertyChanged}" ds:Ds.Placeholder="e.g. Ruwan Perera" MinHeight="48" />
          </StackPanel>
          <StackPanel Margin="8,0,0,0">
            <TextBlock Text="Username" Style="{StaticResource FieldLabel}" Margin="2,0,0,6" />
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" MinHeight="48" />
          </StackPanel>
        </UniformGrid>
        <UniformGrid Columns="2" Margin="0,14,0,0">
          <StackPanel Margin="0,0,8,0">
            <TextBlock Text="PIN (4–8 digits)" Style="{StaticResource FieldLabel}" Margin="2,0,0,6" />
            <PasswordBox x:Name="Pin" Style="{StaticResource PinBox}" />
          </StackPanel>
          <StackPanel Margin="8,0,0,0">
            <TextBlock Text="Same PIN again" Style="{StaticResource FieldLabel}" Margin="2,0,0,6" />
            <PasswordBox x:Name="Confirm" Style="{StaticResource PinBox}" />
          </StackPanel>
        </UniformGrid>
        <TextBlock Text="You use this PIN to sign in and to unlock the screen. Cashiers get their own PIN later." Style="{StaticResource Text.Caption}"
                   TextWrapping="Wrap" Margin="2,8,0,0" />

        <Border CornerRadius="12" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" Padding="14,12" Margin="0,22,0,0" Background="{DynamicResource Brush.Surface}">
          <CheckBox IsChecked="{Binding AddSampleProducts}">
            <StackPanel Margin="4,0,0,0">
              <TextBlock Text="Add 24 sample products" FontWeight="SemiBold" />
              <TextBlock Text="Pet food, feed and medicine to try billing. Remove them any time." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
            </StackPanel>
          </CheckBox>
        </Border>

        <Border CornerRadius="10" Background="{DynamicResource Brush.DangerSoft}" Padding="14,10" Margin="0,14,0,0"
                Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE783;" FontFamily="{StaticResource Font.Icons}" Foreground="{DynamicResource Brush.Danger}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="10,0,0,0" FontWeight="Medium" />
          </StackPanel>
        </Border>

        <Button x:Name="CreateButton" Style="{StaticResource Button.Primary}" Margin="0,22,0,0" MinHeight="56" FontSize="17" HorizontalContentAlignment="Center" Click="OnCreate">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Create and start" VerticalAlignment="Center" />
            <TextBlock Text="&#xE72A;" FontFamily="{StaticResource Font.Icons}" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
