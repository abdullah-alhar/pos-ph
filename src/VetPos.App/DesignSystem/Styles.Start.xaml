<!-- Sign-in, lock and first-start screens: brand panel, PIN keys, PIN dots. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:start="clr-namespace:VetPos.App.Features.Start">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Tokens.xaml" />
    <ResourceDictionary Source="Styles.Inputs.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <SolidColorBrush x:Key="Brush.Brand" Color="#174B4D" />

  <Style TargetType="start:BrandPanel">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="start:BrandPanel">
          <Grid Background="{DynamicResource Brush.Brand}" ClipToBounds="True">
            <DockPanel Margin="56,48">
              <!-- Logo -->
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <Border Width="76" Height="76" CornerRadius="10" Background="White" Padding="8">
                  <Grid>
                    <Image x:Name="AppIcon" Source="/VetPOS;component/Assets/vetpos-256.png" Stretch="Uniform" Visibility="Collapsed" />
                    <Image Source="{TemplateBinding Logo}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                  </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                  <TextBlock Text="VetPOS" FontSize="15" FontWeight="SemiBold" Opacity="0.9" />
                  <TextBlock Text="Point of sale" FontSize="13" Opacity="0.65" />
                </StackPanel>
              </StackPanel>

              <!-- Clock -->
              <StackPanel DockPanel.Dock="Bottom">
                <TextBlock Text="{TemplateBinding TimeText}" FontSize="60" FontWeight="Light" Typography.NumeralAlignment="Tabular" />
                <TextBlock Text="{TemplateBinding DateText}" FontSize="17" Opacity="0.8" Margin="2,0,0,0" />
                <StackPanel Orientation="Horizontal" Margin="2,22,0,0" Opacity="0.65">
                  <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource Font.Icons}" FontSize="13" VerticalAlignment="Center" />
                  <TextBlock Text="Billing works offline." FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>

              <!-- Shop name -->
              <StackPanel VerticalAlignment="Center" Margin="0,0,0,40">
                <TextBlock Text="{TemplateBinding Title}" FontSize="42" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="50" LineStackingStrategy="BlockLineHeight" />
                <TextBlock Text="{TemplateBinding Subtitle}" FontSize="17" Opacity="0.8" TextWrapping="Wrap" Margin="2,12,0,0" />
              </StackPanel>
            </DockPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Logo" Value="{x:Null}">
              <Setter TargetName="AppIcon" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Round phone-style key of the PIN pad -->
  <Style x:Key="PinKey" TargetType="Button">
    <Setter Property="Width" Value="76" />
    <Setter Property="Height" Value="76" />
    <Setter Property="Margin" Value="10,7" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSubtle}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Ellipse x:Name="Disc" Fill="{TemplateBinding Background}" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Disc" Property="Fill" Value="{DynamicResource Brush.AccentSoft}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.94" ScaleY="0.94" /></Setter.Value></Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PinKey.Go" TargetType="Button" BasedOn="{StaticResource PinKey}">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Ellipse x:Name="Disc" Fill="{TemplateBinding Background}" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Disc" Property="Fill" Value="{DynamicResource Brush.AccentHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.94" ScaleY="0.94" /></Setter.Value></Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PinKey.Plain" TargetType="Button" BasedOn="{StaticResource PinKey}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
</ResourceDictionary>
