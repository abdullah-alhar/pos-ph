<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Tokens.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Hierarchy comes from size + weight + colour together. Money uses tabular figures so columns line up. -->
  <Style x:Key="Text.Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="Text.BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Secondary}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
  </Style>
  <!-- Section label: sentence case, a touch heavier than body text (no tracked capitals). -->
  <Style x:Key="Text.Overline" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Secondary}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style x:Key="Text.Emphasis" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Emphasis}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Title}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- Page titles: Inter semibold. -->
  <Style x:Key="Text.PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.PageTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Text.DialogTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.PageTitle}">
    <Setter Property="FontSize" Value="22" />
  </Style>
  <Style x:Key="Text.Money" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Setter Property="TextAlignment" Value="Right" />
  </Style>
  <Style x:Key="Text.MoneyStrong" TargetType="TextBlock" BasedOn="{StaticResource Text.Money}">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- The bill total: the biggest thing on the billing screen. -->
  <Style x:Key="Text.Total" TargetType="TextBlock" BasedOn="{StaticResource Text.Money}">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Total}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="TextTrimming" Value="None" />
  </Style>
  <Style x:Key="Text.Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
    <Setter Property="FontSize" Value="19" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</ResourceDictionary>
