<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ds="clr-namespace:VetPos.App.DesignSystem">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Tokens.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Keyboard focus: a clear 2 px accent ring outside the control (the cashier works by keyboard). -->
  <Style x:Key="FocusRing">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-3" CornerRadius="12" BorderThickness="2" BorderBrush="{DynamicResource Brush.Accent}" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Small key chip: "F12", "Ctrl+K". -->
  <Style x:Key="KeyCap" TargetType="Border">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="5,1,5,1" />
    <Setter Property="MinWidth" Value="20" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{DynamicResource Brush.KeyCap}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="KeyCap.Text" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <ControlTemplate x:Key="ButtonTemplate" TargetType="Button">
    <Border x:Name="Root"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{StaticResource Radius.Button}"
            Padding="{TemplateBinding Padding}"
            SnapsToDevicePixels="True">
      <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Icon" Grid.Column="0" Margin="0,0,8,0"
                   Text="{TemplateBinding ds:Ds.Icon}" FontFamily="{StaticResource Font.Icons}" FontSize="19"
                   Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"
                          TextElement.Foreground="{TemplateBinding Foreground}" />
        <!-- Chip background = the text colour at 16 %, so it works on every button variant. -->
        <Border x:Name="Hint" Grid.Column="2" Margin="10,0,0,0" CornerRadius="4"
                Background="{TemplateBinding Foreground}" Opacity="0.16" />
        <TextBlock x:Name="HintText" Grid.Column="2" Margin="10,0,0,0" Padding="5,1,5,1" MinWidth="20"
                   Text="{TemplateBinding ds:Ds.KeyHint}" FontSize="13" FontWeight="SemiBold"
                   TextAlignment="Center" VerticalAlignment="Center"
                   Foreground="{TemplateBinding Foreground}" Opacity="0.8" />
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="ds:Ds.Icon" Value="{x:Null}">
        <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="ds:Ds.KeyHint" Value="{x:Null}">
        <Setter TargetName="Hint" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="HintText" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="Content" Value="{x:Null}">
        <Setter TargetName="Icon" Property="Margin" Value="0" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Root" Property="Opacity" Value="0.45" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- Outline: the default button (card surface, hairline border), like the old POS. -->
  <Style x:Key="Button.Outline" TargetType="Button">
    <Setter Property="Template" Value="{StaticResource ButtonTemplate}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="MinHeight" Value="{StaticResource Height.Control}" />
    <Setter Property="Padding" Value="16,0,16,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSubtle}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSunken}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Outline}">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSubtle}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.LineStrong}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Button.Small" TargetType="Button" BasedOn="{StaticResource Button.Outline}">
    <Setter Property="MinHeight" Value="{StaticResource Height.ControlSmall}" />
    <Setter Property="Padding" Value="12,0,12,0" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Secondary}" />
  </Style>
  <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Outline}">
    <Setter Property="MinHeight" Value="{StaticResource Height.ControlSmall}" />
    <Setter Property="Width" Value="38" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- Primary: one per screen — the main action. -->
  <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Outline}">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentHover}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentPressed}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Large primary: "Pay & print" on the billing screen. -->
  <Style x:Key="Button.PrimaryLarge" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
    <Setter Property="MinHeight" Value="{StaticResource Height.Pay}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Title}" />
    <Setter Property="Padding" Value="20,0,20,0" />
  </Style>

  <!-- Pay: a deep, confident green-teal, the strongest button on the screen. -->
  <Style x:Key="Button.Pay" TargetType="Button" BasedOn="{StaticResource Button.PrimaryLarge}">
    <Setter Property="Background" Value="{DynamicResource Brush.Pay}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="Bold" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.PayHover}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.PayHover}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.45" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Subtle: toolbar and secondary actions; no border until hovered. -->
  <Style x:Key="Button.Subtle" TargetType="Button" BasedOn="{StaticResource Button.Outline}">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Pressed}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Danger: void a bill, delete. -->
  <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Outline}">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Opacity" Value="0.9" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <!-- Big payment method tile (Cash / Card / Bank). -->
  <Style x:Key="PayTile" TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="MinHeight" Value="60" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Root" CornerRadius="12" BorderThickness="2" BorderBrush="{DynamicResource Brush.Line}" Background="{DynamicResource Brush.Surface}" Padding="8">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.LineStrong}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Inline editable value (price on a bill line): looks like text, shows a box on hover / when editing. -->
  <Style x:Key="InlineEdit" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Cursor" Value="IBeam" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Setter Property="ToolTip" Value="Click to change the price for this bill" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Frame" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Brush.Transparent}" Background="{DynamicResource Brush.Transparent}" Padding="6,3">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.LineStrong}" />
              <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Brush.Surface}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
              <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Brush.Surface}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Segmented choice (discount type, payment method): the chosen one looks raised. -->
  <Style x:Key="Segment" TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Root" CornerRadius="8" Padding="14,7,14,7" Background="{DynamicResource Brush.Transparent}">
            <ContentPresenter HorizontalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
