<!--
  Design tokens ("Bright counter", v0.9): IBM Plex Sans for everything (clinical, very clear numbers),
  radius 10 for controls / 14 for panels / 18 for floating sheets, 46 px controls (easy to hit, easy to read), 4/8 spacing.
  No shadows on cards: panels are separated by surface colour and hairlines. Only floating layers
  (dialogs, menus, toasts) cast a shadow. This also keeps the app fast on PCs without a GPU.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Bundled fonts: the till looks the same on every PC, with or without internet. -->
  <FontFamily x:Key="Font.Text">pack://application:,,,/VetPOS;component/Assets/Fonts/#IBM Plex Sans, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Display">pack://application:,,,/VetPOS;component/Assets/Fonts/#IBM Plex Sans, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>

  <sys:Double x:Key="FontSize.Tiny">12</sys:Double>
  <sys:Double x:Key="FontSize.Caption">13</sys:Double>
  <sys:Double x:Key="FontSize.Secondary">14</sys:Double>
  <sys:Double x:Key="FontSize.Body">16</sys:Double>
  <sys:Double x:Key="FontSize.Nav">16</sys:Double>
  <sys:Double x:Key="FontSize.Emphasis">18</sys:Double>
  <sys:Double x:Key="FontSize.Large">20</sys:Double>
  <sys:Double x:Key="FontSize.Title">22</sys:Double>
  <sys:Double x:Key="FontSize.PageTitle">28</sys:Double>
  <sys:Double x:Key="FontSize.Total">52</sys:Double>

  <sys:Double x:Key="Space.1">4</sys:Double>
  <sys:Double x:Key="Space.2">8</sys:Double>
  <sys:Double x:Key="Space.3">12</sys:Double>
  <sys:Double x:Key="Space.4">16</sys:Double>
  <sys:Double x:Key="Space.5">24</sys:Double>
  <sys:Double x:Key="Space.6">32</sys:Double>
  <sys:Double x:Key="Space.7">48</sys:Double>
  <Thickness x:Key="Pad.Control">12,0,12,0</Thickness>
  <Thickness x:Key="Pad.Card">20</Thickness>
  <Thickness x:Key="Pad.Page">24,20,24,20</Thickness>

  <sys:Double x:Key="Height.ControlSmall">36</sys:Double>
  <sys:Double x:Key="Height.Control">42</sys:Double>
  <sys:Double x:Key="Height.ControlLarge">56</sys:Double>
  <sys:Double x:Key="Height.Pay">72</sys:Double>
  <sys:Double x:Key="Height.Row">56</sys:Double>
  <sys:Double x:Key="Width.Sidebar">218</sys:Double>
  <sys:Double x:Key="Width.SidebarCollapsed">72</sys:Double>
  <sys:Double x:Key="Width.TotalsPanel">360</sys:Double>

  <CornerRadius x:Key="Radius.Small">6</CornerRadius>
  <CornerRadius x:Key="Radius.Input">7</CornerRadius>
  <CornerRadius x:Key="Radius.Button">7</CornerRadius>
  <CornerRadius x:Key="Radius.Card">8</CornerRadius>
  <CornerRadius x:Key="Radius.Sheet">18</CornerRadius>
  <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

  <DropShadowEffect x:Key="Shadow.Card" BlurRadius="10" ShadowDepth="1" Direction="270" Opacity="0.05" Color="#0E2A28" RenderingBias="Performance" />
  <DropShadowEffect x:Key="Shadow.Sheet" BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.16" Color="#0B1F1E" RenderingBias="Performance" />
</ResourceDictionary>
