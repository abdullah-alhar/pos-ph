<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ds="clr-namespace:VetPos.App.DesignSystem">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Tokens.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!--
    Text input. Focus shows a 2 px accent ring drawn over the border (no layout jump).
    ds:Ds.Placeholder, ds:Ds.Icon and ds:Ds.KeyHint are optional; ds:Ds.Error shows a red
    border and the message under the field.
  -->
  <ControlTemplate x:Key="TextBoxTemplate" TargetType="TextBox">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid MinHeight="{TemplateBinding MinHeight}">
        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1" CornerRadius="{StaticResource Radius.Input}" SnapsToDevicePixels="True" />
        <Border x:Name="Ring" BorderThickness="2" CornerRadius="{StaticResource Radius.Input}"
                BorderBrush="{DynamicResource Brush.Accent}" Visibility="Collapsed" SnapsToDevicePixels="True" />
        <Grid Margin="{TemplateBinding Padding}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="Icon" Margin="0,0,10,0" Text="{TemplateBinding ds:Ds.Icon}"
                     FontFamily="{StaticResource Font.Icons}" FontSize="16" VerticalAlignment="Center"
                     Foreground="{DynamicResource Brush.TextTertiary}" />
          <TextBlock x:Name="Placeholder" Grid.Column="1" Text="{TemplateBinding ds:Ds.Placeholder}"
                     Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Center"
                     FontSize="{TemplateBinding FontSize}" Margin="2,0,0,0" Visibility="Collapsed"
                     IsHitTestVisible="False" TextTrimming="CharacterEllipsis" />
          <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Cursor="IBeam" />
          <Border x:Name="Hint" Grid.Column="2" Margin="8,0,0,0" Style="{DynamicResource KeyCap}">
            <TextBlock Text="{TemplateBinding ds:Ds.KeyHint}" Style="{DynamicResource KeyCap.Text}" />
          </Border>
        </Grid>
      </Grid>
      <TextBlock x:Name="ErrorText" Grid.Row="1" Margin="2,6,0,0" Text="{TemplateBinding ds:Ds.Error}"
                 Foreground="{DynamicResource Brush.Danger}" FontSize="{StaticResource FontSize.Secondary}"
                 TextWrapping="Wrap" Visibility="Collapsed" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="Text" Value="">
        <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="ds:Ds.Icon" Value="{x:Null}">
        <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="ds:Ds.KeyHint" Value="{x:Null}">
        <Setter TargetName="Hint" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.TextTertiary}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
        <Setter TargetName="Hint" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="ds:Ds.HasError" Value="True">
        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
        <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
        <Setter TargetName="ErrorText" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.5" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="Input" TargetType="TextBox">
    <Setter Property="Template" Value="{StaticResource TextBoxTemplate}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Cursor" Value="IBeam" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.LineStrong}" />
    <Setter Property="MinHeight" Value="{StaticResource Height.Control}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Padding" Value="{StaticResource Pad.Control}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <!-- No endless text: one-line boxes take 300 characters, multi-line boxes (notes, AI, pasted lists) 12,000. -->
    <Setter Property="MaxLength" Value="300" />
    <Style.Triggers>
      <Trigger Property="AcceptsReturn" Value="True">
        <Setter Property="MaxLength" Value="12000" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Money and quantity fields: numbers line up on the right. -->
  <Style x:Key="Input.Number" TargetType="TextBox" BasedOn="{StaticResource Input}">
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>

  <!-- The scan / search box on the billing screen: big and always ready. -->
  <Style x:Key="Input.Search" TargetType="TextBox" BasedOn="{StaticResource Input}">
    <Setter Property="MinHeight" Value="{StaticResource Height.ControlLarge}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Large}" />
    <Setter Property="Padding" Value="14,0,12,0" />
    <Setter Property="Background" Value="{DynamicResource Brush.Background}" />
    <Setter Property="ds:Ds.Icon" Value="&#xEE6F;" />
  </Style>

  <!-- PIN box: big, centred dots. -->
  <Style x:Key="PinBox" TargetType="PasswordBox">
    <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="MaxLength" Value="8" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.LineStrong}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Cursor" Value="IBeam" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="InputMethod.IsInputMethodEnabled" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Grid>
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius.Input}" />
            <Border x:Name="Ring" BorderThickness="2" CornerRadius="{StaticResource Radius.Input}" BorderBrush="{DynamicResource Brush.Accent}" Visibility="Collapsed" />
            <ScrollViewer x:Name="PART_ContentHost" Margin="14,0,14,0" VerticalAlignment="Center" Focusable="False" Cursor="IBeam" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Label above a field. -->
  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Secondary}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="Margin" Value="2,0,0,6" />
  </Style>
</ResourceDictionary>
