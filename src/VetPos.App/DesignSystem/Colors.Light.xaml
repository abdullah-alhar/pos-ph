<!-- The palette ("VetPOS Figma design"): white surfaces, Figma teal accent (#0F8B8D), clean borders (#C9D3DF),
     and crisp dark text (#0F1B2D). Every colour in the app comes from here; screens never use hardcoded hex values. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="Color.Background">#F3F6FB</Color>
  <Color x:Key="Color.Surface">#FFFFFF</Color>
  <Color x:Key="Color.SurfaceSubtle">#E4E9F0</Color>
  <Color x:Key="Color.SurfaceSunken">#F3F6FB</Color>
  <Color x:Key="Color.Line">#C9D3DF</Color>
  <Color x:Key="Color.LineStrong">#9AAABF</Color>
  <Color x:Key="Color.Text">#0F1B2D</Color>
  <Color x:Key="Color.TextSecondary">#5B6B7F</Color>
  <Color x:Key="Color.TextTertiary">#8291A5</Color>
  <Color x:Key="Color.Accent">#0F8B8D</Color>
  <Color x:Key="Color.AccentHover">#0B5E60</Color>
  <Color x:Key="Color.AccentPressed">#08484A</Color>
  <Color x:Key="Color.AccentSoft">#E3F3F2</Color>
  <Color x:Key="Color.AccentText">#0B5E60</Color>
  <Color x:Key="Color.OnAccent">#FFFFFF</Color>
  <Color x:Key="Color.Success">#16A34A</Color>
  <Color x:Key="Color.SuccessSoft">#DCF5E5</Color>
  <Color x:Key="Color.Warning">#EA7C0B</Color>
  <Color x:Key="Color.WarningSoft">#FEF0D7</Color>
  <Color x:Key="Color.Danger">#D12E2E</Color>
  <Color x:Key="Color.DangerSoft">#FDE6E6</Color>
  <Color x:Key="Color.Scrim">#66101F1E</Color>
  <Color x:Key="Color.Sidebar">#FFFFFF</Color>
  <Color x:Key="Color.SidebarAccent">#E3F3F2</Color>
  <Color x:Key="Color.SidebarText">#0F1B2D</Color>
  <Color x:Key="Color.SidebarMuted">#5B6B7F</Color>
  <Color x:Key="Color.SidebarLine">#E4E9F0</Color>
  <Color x:Key="Color.SidebarPrimary">#0F8B8D</Color>
  <Color x:Key="Color.Marigold">#0F8B8D</Color>
  <Color x:Key="Color.MarigoldHover">#0B5E60</Color>
  <Color x:Key="Color.OnMarigold">#FFFFFF</Color>
  <Color x:Key="Color.KeyCap">#E4E9F0</Color>
  <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
  <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
  <SolidColorBrush x:Key="Brush.SurfaceSubtle" Color="{StaticResource Color.SurfaceSubtle}" />
  <SolidColorBrush x:Key="Brush.SurfaceSunken" Color="{StaticResource Color.SurfaceSunken}" />
  <SolidColorBrush x:Key="Brush.Line" Color="{StaticResource Color.Line}" />
  <SolidColorBrush x:Key="Brush.LineStrong" Color="{StaticResource Color.LineStrong}" />
  <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
  <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource Color.TextTertiary}" />
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
  <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
  <SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource Color.AccentPressed}" />
  <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />
  <SolidColorBrush x:Key="Brush.AccentText" Color="{StaticResource Color.AccentText}" />
  <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />
  <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
  <SolidColorBrush x:Key="Brush.SuccessSoft" Color="{StaticResource Color.SuccessSoft}" />
  <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
  <SolidColorBrush x:Key="Brush.WarningSoft" Color="{StaticResource Color.WarningSoft}" />
  <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
  <SolidColorBrush x:Key="Brush.DangerSoft" Color="{StaticResource Color.DangerSoft}" />
  <SolidColorBrush x:Key="Brush.Scrim" Color="{StaticResource Color.Scrim}" />
  <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Sidebar}" />
  <SolidColorBrush x:Key="Brush.SidebarAccent" Color="{StaticResource Color.SidebarAccent}" />
  <SolidColorBrush x:Key="Brush.SidebarText" Color="{StaticResource Color.SidebarText}" />
  <SolidColorBrush x:Key="Brush.SidebarMuted" Color="{StaticResource Color.SidebarMuted}" />
  <SolidColorBrush x:Key="Brush.SidebarLine" Color="{StaticResource Color.SidebarLine}" />
  <SolidColorBrush x:Key="Brush.SidebarPrimary" Color="{StaticResource Color.SidebarPrimary}" />
  <SolidColorBrush x:Key="Brush.Marigold" Color="{StaticResource Color.Marigold}" />
  <SolidColorBrush x:Key="Brush.MarigoldHover" Color="{StaticResource Color.MarigoldHover}" />
  <SolidColorBrush x:Key="Brush.OnMarigold" Color="{StaticResource Color.OnMarigold}" />
  <SolidColorBrush x:Key="Brush.Pay" Color="#16A34A" />
  <SolidColorBrush x:Key="Brush.PayHover" Color="#13893F" />
  <SolidColorBrush x:Key="Brush.KeyCap" Color="{StaticResource Color.KeyCap}" />
  <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource Color.Text}" Opacity="0.04" />
  <SolidColorBrush x:Key="Brush.Pressed" Color="{StaticResource Color.Text}" Opacity="0.08" />
  <SolidColorBrush x:Key="Brush.Transparent" Color="Transparent" />
  <SolidColorBrush x:Key="Brush.OnAccentChip" Color="#FFFFFF" Opacity="0.22" />
  <SolidColorBrush x:Key="Brush.Selection" Color="{StaticResource Color.Accent}" Opacity="0.25" />
  <Color x:Key="SystemAccentColor">#0F8B8D</Color>
</ResourceDictionary>
